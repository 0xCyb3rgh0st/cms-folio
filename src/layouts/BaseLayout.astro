---
import Terminal from '../components/Terminal.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = "Jatin Singh | Cybersecurity Researcher", description = "Cybersecurity researcher specializing in binary exploitation, active directory attacks, and web application security." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jatin Singh - Security Researcher specializing in exploit development, reverse engineering, and Active Directory security. BSc Ethical Hacking & Cyber Security (2026)." />
    <meta name="keywords" content="security researcher, exploit developer, reverse engineering, cybersecurity, penetration testing, vulnerability research" />
    <meta name="author" content="Jatin Singh" />
    <meta name="theme-color" content="#0d1117" />
    <meta property="og:title" content="Jatin Singh | Security Researcher & Exploit Developer" />
    <meta property="og:description" content="Building world-class open-source tools for vulnerability research." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jatinsingh.com.np" />
    <meta property="og:site_name" content="Jatin Singh" />
    <meta property="og:image" content="https://jatinsingh.com.np/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jatin Singh | Security Researcher & Exploit Developer" />
    <meta name="twitter:description" content="Security researcher. I like finding bugs, writing exploits, and automating things I'm too lazy to do twice." />
    <meta name="twitter:image" content="https://jatinsingh.com.np/og-image.png" />
    <meta name="twitter:creator" content="@0xCyb3rgh0st" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jatin Singh",
        "jobTitle": "Security Researcher & Exploit Developer",
        "email": "info@jatinsingh.com.np",
        "url": "https://jatinsingh.com.np",
        "alumniOf": "Coventry University",
        "knowsAbout": ["Exploit Development", "Reverse Engineering", "Active Directory Security", "Binary Analysis"]
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://jatinsingh.com.np" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content" style="position:absolute;top:-100px;left:16px;z-index:100;background:var(--green);color:var(--bg-primary);padding:12px 24px;border-radius:0 0 var(--radius) var(--radius);font-family:'JetBrains Mono',monospace;font-size:0.85rem;font-weight:600;text-decoration:none;transition:top 0.2s ease-in-out;" onfocus="this.style.top='0'" onblur="this.style.top='-100px'">
      Skip to content
    </a>
    <slot />
    <Terminal />
  </body>
</html>
<style is:global>
  @import "../styles/global.css";
</style>
