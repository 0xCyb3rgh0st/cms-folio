---
interface Props {
  title?: string;
  description?: string;
}
const { title = "Jatin Singh | Cybersecurity Researcher", description = "Cybersecurity researcher specializing in binary exploitation, active directory attacks, and web application security." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jatinsingh.com.np" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://jatinsingh.com.np" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-to-content" style="position:absolute;top:-100px;left:16px;z-index:100;background:var(--green);color:var(--bg-primary);padding:12px 24px;border-radius:0 0 var(--radius) var(--radius);font-family:'JetBrains Mono',monospace;font-size:0.85rem;font-weight:600;text-decoration:none;transition:top 0.2s ease-in-out;" onfocus="this.style.top='0'" onblur="this.style.top='-100px'">
      Skip to content
    </a>
    <slot />
  </body>
</html>
<style is:global>
  @import "../styles/global.css";
</style>
