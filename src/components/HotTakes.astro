---
const takes = [
  { num: "01", title: "Tools don't make you a hacker. Understanding does." },
  { num: "02", title: "Certifications prove you passed an exam, not that you can hack." },
  { num: "03", title: "Pentesting becomes mediocre when it becomes checklist-driven." },
  { num: "04", title: "You can't understand security without understanding IT." },
  { num: "05", title: "The basics are usually more important than the newest security product." },
  { num: "06", title: "If you don't understand why something is vulnerable, finding it isn't enough." },
];
---
<section id="hot-takes" style="padding:96px 24px;background:var(--bg-secondary);" aria-labelledby="takes-heading">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'Source Code Pro',monospace;color:var(--red);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// unpopular opinions</p>
    <h2 id="takes-heading" style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:8px;">
      <span style="color:var(--text);">Things I </span><span style="background:linear-gradient(135deg,var(--red),var(--orange));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Believe</span>
    </h2>
    <p style="color:var(--text-muted);margin-bottom:48px;max-width:600px;">Some opinions are better tested than repeated.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(480px,1fr));gap:20px;">
      {takes.map((t) => (
        <div style="display:flex;flex-direction:column;gap:16px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:28px;transition:all 0.2s ease-in-out;height:100%;" onmouseover="this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--border)';this.style.transform='none'">
          <div style="font-family:'Source Code Pro',monospace;font-size:0.8rem;color:var(--red);letter-spacing:0.1em;" aria-hidden="true">{t.num}</div>
          <h3 style="font-size:1.2rem;font-weight:600;color:var(--text);line-height:1.5;">{t.title}</h3>
        </div>
      ))}
    </div>
  </div>
</section>