---
const categories = [
  {
    title: "Binary Exploitation", icon: "0x", color: "var(--green)",
    skills: [{ name: "Buffer Overflows", level: 5 }, { name: "ROP Chains", level: 4 }, { name: "Heap Exploitation", level: 3 }, { name: "Format String", level: 4 }, { name: "Shellcode Writing", level: 4 }],
    tags: ["GDB", "pwndbg", "pwntools", "ROPgadget"],
  },
  {
    title: "Web Security", icon: "W/", color: "var(--cyan)",
    skills: [{ name: "XSS", level: 5 }, { name: "SQL Injection", level: 5 }, { name: "SSRF", level: 4 }, { name: "XXE", level: 3 }, { name: "Auth Bypass", level: 4 }],
    tags: ["Burp Suite", "Nuclei", "SQLMap", "XSStrike"],
  },
  {
    title: "Active Directory", icon: "AD", color: "var(--purple)",
    skills: [{ name: "Kerberoasting", level: 5 }, { name: "AS-REP Roasting", level: 4 }, { name: "Pass-the-Hash", level: 5 }, { name: "DCSync", level: 4 }, { name: "GPO Abuse", level: 3 }],
    tags: ["BloodHound", "Impacket", "Rubeus", "Mimikatz"],
  },
  {
    title: "Forensics & RE", icon: "F+", color: "var(--green)",
    skills: [{ name: "Malware Analysis", level: 4 }, { name: "Memory Forensics", level: 3 }, { name: "Reverse Engineering", level: 4 }, { name: "Network Forensics", level: 3 }, { name: "Disk Forensics", level: 3 }],
    tags: ["Ghidra", "Volatility", "Wireshark", "Strings"],
  },
];
---
<section id="skills" style="padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.875rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// skills</p>
    <h2 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:48px;">
      <span style="color:var(--text);">Technical </span><span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Arsenal</span>
    </h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
      {categories.map((cat) => (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:24px;transition:border-color 0.3s;" onmouseover="this.style.borderColor=cat_color" onmouseout="this.style.borderColor='var(--border)'" data-color={cat.color}>
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style={`width:48px;height:48px;border-radius:8px;background:var(--bg-tertiary);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-weight:700;color:${cat.color};font-size:1rem;`}>
              {cat.icon}
            </div>
            <h3 style="font-size:1.125rem;font-weight:700;color:var(--text);">{cat.title}</h3>
          </div>
          <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:24px;">
            {cat.skills.map((skill) => (
              <div>
                <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                  <span style="color:var(--text-muted);font-size:0.8rem;font-family:'JetBrains Mono',monospace;">{skill.name}</span>
                  <span style="color:var(--text-muted);font-size:0.75rem;font-family:'JetBrains Mono',monospace;">{skill.level}/5</span>
                </div>
                <div style="height:6px;background:var(--bg-tertiary);border-radius:3px;overflow:hidden;">
                  <div style={`height:100%;width:${(skill.level / 5) * 100}%;background:${cat.color};border-radius:3px;box-shadow:0 0 8px ${cat.color};transition:width 1s ease;`}></div>
                </div>
              </div>
            ))}
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            {cat.tags.map((tag) => (
              <span style={`display:inline-flex;padding:2px 8px;font-size:0.7rem;font-family:'JetBrains Mono',monospace;border-radius:4px;background:${cat.color}15;color:${cat.color};border:1px solid ${cat.color}33;`}>
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
