---
---
<section id="windows" style="padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.875rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// windows</p>
    <h2 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:48px;">
      <span style="color:var(--text);">Windows </span><span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Offense</span>
    </h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px;">
      <div style="display:flex;flex-direction:column;gap:20px;">
        {[
          { title: "AD Attack Surface", desc: "Deep understanding of Active Directory attack vectors.", tags: ["Kerberos", "NTLM", "GPO", "ACLs"] },
          { title: "Post-Exploitation", desc: "Windows privilege escalation and persistence techniques.", tags: ["Mimikatz", "Rubeus", "SharpHound", "Certify"] },
          { title: "Defense Evasion", desc: "Bypassing Windows security controls and EDR solutions.", tags: ["AMSI", "ETW", "AppLocker", "WDAC"] },
        ].map((s) => (
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:24px;" onmouseover="this.style.borderColor='var(--purple)'" onmouseout="this.style.borderColor='var(--border)'">
            <h3 style="font-weight:700;color:var(--text);margin-bottom:8px;">{s.title}</h3>
            <p style="color:var(--text-muted);font-size:0.875rem;margin-bottom:12px;line-height:1.6;">{s.desc}</p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              {s.tags.map((t) => (
                <span style="display:inline-flex;padding:2px 8px;font-size:0.7rem;font-family:'JetBrains Mono',monospace;border-radius:4px;background:rgba(139,92,246,0.1);color:var(--purple);border:1px solid rgba(139,92,246,0.2);">{t}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:12px;overflow:hidden;">
        <div style="background:var(--bg-tertiary);padding:10px 16px;display:flex;align-items:center;gap:6px;border-bottom:1px solid var(--border);">
          <div style="width:10px;height:10px;border-radius:50%;background:var(--red);"></div>
          <div style="width:10px;height:10px;border-radius:50%;background:var(--yellow);"></div>
          <div style="width:10px;height:10px;border-radius:50%;background:var(--green);"></div>
          <span style="margin-left:8px;color:var(--text-muted);font-size:0.75rem;font-family:'JetBrains Mono',monospace;">powershell.exe</span>
        </div>
        <div style="padding:20px;font-family:'JetBrains Mono',monospace;font-size:0.75rem;line-height:2;">
          <p><span style="color:var(--cyan);">PS C:\&gt;</span> <span style="color:var(--green);">Import-Module ActiveDirectory</span></p>
          <p><span style="color:var(--cyan);">PS C:\&gt;</span> <span style="color:var(--green);">Get-ADDomain</span></p>
          <p style="padding-left:16px;color:var(--text-muted);">DomainSID : S-1-5-21-...</p>
          <p style="padding-left:16px;color:var(--text-muted);">DomainMode : Windows2016Domain</p>
          <p><span style="color:var(--cyan);">PS C:\&gt;</span> <span style="color:var(--green);">Get-DomainUser -SPN</span></p>
          <p style="padding-left:16px;color:var(--text-muted);">samaccountname : svc_sql</p>
          <p style="padding-left:16px;color:var(--text-muted);">SPN : MSSQLSvc/sql01</p>
          <p><span style="color:var(--cyan);">PS C:\&gt;</span> <span style="animation:pulse-glow 2s infinite;">_</span></p>
        </div>
      </div>
    </div>
  </div>
</section>
