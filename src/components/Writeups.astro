---
import Badge from './ui/Badge.astro';

const writeups = [
  {
    title: "HackTheBox - UnderWriteUp",
    description: "OSCP-style machine with web enumeration and privilege escalation via kernel exploit.",
    category: "ctf",
    difficulty: "medium",
    date: "2024-08-15",
    tags: ["HTB", "Linux", "PrivEsc"],
  },
  {
    title: "CVE-2024-3094: XZ Utils Backdoor",
    description: "Deep dive into the XZ Utils supply chain attack and its implications for Linux security.",
    category: "vulnerability",
    difficulty: "hard",
    date: "2024-04-01",
    tags: ["CVE", "Supply Chain", "Linux"],
  },
  {
    title: "Kerberoasting from Scratch",
    description: "Complete guide to Kerberoasting attacks in Active Directory environments.",
    category: "technique",
    difficulty: "medium",
    date: "2024-03-20",
    tags: ["AD", "Kerberos", "CrackMapExec"],
  },
  {
    title: "Buffer Overflow Lab Walkthrough",
    description: "Step-by-step stack buffer overflow exploitation from discovery to shell.",
    category: "technique",
    difficulty: "easy",
    date: "2024-02-10",
    tags: ["Binary", "Pwn", "GDB"],
  },
  {
    title: "TryHackMe - Active Directory Basics",
    description: "Foundational AD concepts and common attack paths for beginners.",
    category: "lab",
    difficulty: "easy",
    date: "2024-01-15",
    tags: ["THM", "AD", "Beginner"],
  },
  {
    title: "Burp Suite Advanced Techniques",
    description: "Mastering Burp Suite for complex web application penetration testing.",
    category: "tool",
    difficulty: "hard",
    date: "2024-07-22",
    tags: ["Burp", "Web", "Proxy"],
  },
];

const difficultyColors: Record<string, "green" | "yellow" | "red" | "purple"> = {
  easy: "green",
  medium: "yellow",
  hard: "red",
  insane: "purple",
};

const categoryColors: Record<string, "green" | "cyan" | "purple" | "yellow" | "orange"> = {
  ctf: "cyan",
  vulnerability: "red",
  technique: "green",
  tool: "purple",
  lab: "yellow",
};
---

<section id="writeups" class="py-24 px-6">
  <div class="mx-auto max-w-6xl">
    <p class="section-heading">// writeups</p>
    <h2 class="text-3xl md:text-4xl font-bold mb-12">
      <span class="text-text-primary">Security</span> <span class="gradient-text">Journal</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {writeups.map((writeup) => (
        <article class="glass-card p-6 flex flex-col group">
          <div class="flex items-center gap-2 mb-3">
            <Badge text={writeup.category} color={categoryColors[writeup.category] || "green"} />
            <Badge text={writeup.difficulty} color={difficultyColors[writeup.difficulty] || "green"} />
          </div>
          <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-accent-green transition-colors">
            {writeup.title}
          </h3>
          <p class="text-text-secondary text-sm mb-4 flex-grow leading-relaxed">
            {writeup.description}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            {writeup.tags.map((tag) => (
              <span class="text-xs font-mono text-text-secondary bg-bg-tertiary px-2 py-1 rounded">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex items-center justify-between">
            <span class="text-text-secondary text-xs font-mono">{writeup.date}</span>
            <span class="text-accent-green text-sm font-mono hover:underline cursor-pointer">
              Read more &rarr;
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
