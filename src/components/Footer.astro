<footer style="border-top:1px solid var(--border);background:#0d0d0d;margin-top:96px;position:relative;z-index:1;">
  <div style="max-width:1200px;margin:0 auto;padding:48px 24px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;">
      <div>
        <p style="font-family:'Source Code Pro',monospace;color:var(--red);font-weight:700;font-size:1rem;margin-bottom:12px;">&lt;Jatin/&gt;</p>
