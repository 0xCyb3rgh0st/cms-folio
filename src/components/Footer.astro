<style>
  .footer-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease, padding-left 0.2s ease;
    display: inline-block;
  }
  .footer-link:hover {
    color: var(--text);
    padding-left: 4px;
  }
  .footer-link.red-link:hover {
    color: var(--red);
  }
</style>
