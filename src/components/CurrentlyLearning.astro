---
const learnings = [
  { topic: "Windows Kernel Exploitation", status: "fighting", desc: "Still trying to get a stable kernel read primitive. The pool internals are a nightmare." },
  { topic: "Firmware RE", status: "exploring", desc: "Extracting and analyzing IoT firmware. Currently learning binwalk and firmwalker workflows." },
  { topic: "Rust for Tooling", status: "daily", desc: "Rewriting pwnlibc internals in Rust. The borrow checker fights me but the result is worth it." },
];
---
<section id="currently-learning" style="padding:96px 24px;" aria-labelledby="learning-heading">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// currently learning</p>
    <h2 id="learning-heading" style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:8px;">
      <span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">August</span>
      <span style="color:var(--text);"> 2026</span>
    </h2>
    <p style="color:var(--text-muted);margin-bottom:40px;max-width:600px;">What I'm working on right now. The messy middle, not the polished result.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:20px;">
      {learnings.map((l) => (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--border-hover)'" onmouseout="this.style.borderColor='var(--border)'">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
            <span style={`width:8px;height:8px;border-radius:50%;flex-shrink:0;${l.status === 'fighting' ? 'background:var(--red);box-shadow:0 0 8px var(--red);' : l.status === 'exploring' ? 'background:var(--yellow);box-shadow:0 0 8px var(--yellow);' : 'background:var(--green);box-shadow:0 0 8px var(--green);'}`}></span>
            <span style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);">{l.status}</span>
          </div>
          <h3 style="font-size:1.05rem;font-weight:600;color:var(--text);margin-bottom:8px;">{l.topic}</h3>
          <p style="color:var(--text-muted);font-size:0.875rem;line-height:1.6;">{l.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
