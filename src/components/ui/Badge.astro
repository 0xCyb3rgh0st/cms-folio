---
interface Props {
  text: string;
  color?: "green" | "cyan" | "purple" | "red" | "yellow" | "orange";
  class?: string;
}

const { text, color = "green", class: className = "" } = Astro.props;

const colors = {
  green: "bg-accent-green/10 text-accent-green border-accent-green/20",
  cyan: "bg-accent-cyan/10 text-accent-cyan border-accent-cyan/20",
  purple: "bg-accent-purple/10 text-accent-purple border-accent-purple/20",
  red: "bg-accent-red/10 text-accent-red border-accent-red/20",
  yellow: "bg-accent-yellow/10 text-accent-yellow border-accent-yellow/20",
  orange: "bg-accent-orange/10 text-accent-orange border-accent-orange/20",
};
---

<span class:list={["inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono border", colors[color], className]}>
  {text}
</span>
