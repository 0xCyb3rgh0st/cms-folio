---
const certs = [
  { title: "CRTO", issuer: "Zero-Point Security", color: "var(--red)" },
  { title: "CPTS", issuer: "Hack The Box", color: "var(--cyan)" },
  { title: "eWPTXv3", issuer: "INE Security", color: "var(--green)" },
  { title: "CRTA", issuer: "Zero-Point Security", color: "var(--yellow)" },
  { title: "ACP", issuer: "Pentester Academy", color: "var(--purple)" },
];
---
<section id="certifications" style="padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.875rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// certifications</p>
    <h2 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:48px;">
      <span style="color:var(--text);">Verified </span><span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Credentials</span>
    </h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;">
      {certs.map((c) => (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:20px;display:flex;align-items:center;gap:16px;transition:all 0.3s;" onmouseover="this.style.borderColor='var(--green)'" onmouseout="this.style.borderColor='var(--border)'">
          <div style={`width:56px;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:0.8rem;background:${c.color}15;color:${c.color};border:1px solid ${c.color}33;flex-shrink:0;`}>
            {c.title.substring(0, 3)}
          </div>
          <div>
            <h3 style="font-weight:700;color:var(--text);font-size:0.95rem;">{c.title}</h3>
            <p style="color:var(--text-muted);font-size:0.8rem;">{c.issuer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
