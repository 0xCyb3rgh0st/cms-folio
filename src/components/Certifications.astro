---
const certs = [
  { title: "CRTO", issuer: "Zero-Point Security", color: "var(--red)", slug: "crto", icon: "ZPS" },
  { title: "CPTS", issuer: "Hack The Box", color: "var(--cyan)", slug: "cpts", icon: "HTB" },
  { title: "eWPTXv3", issuer: "INE Security", color: "var(--purple)", slug: "ewptxv3", icon: "INE" },
  { title: "CRTA", issuer: "Cyber Warfare Labs", color: "var(--orange)", slug: "crta", icon: "CWL" },
  { title: "ACP", issuer: "APIsec", color: "var(--red)", slug: "acp", icon: "API" },
];
---
<section id="certifications" style="padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'Source Code Pro',monospace;color:var(--red);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// certifications</p>
    <h2 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:48px;">
      <span style="color:var(--text);">Verified </span><span style="background:linear-gradient(135deg,var(--red),var(--orange));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Credentials</span>
    </h2>
    <div class="scroll-stagger" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;">
      {certs.map((c) => (
        <a href={`/certifications/${c.slug}`} class="card-3d" style="text-decoration:none;display:block;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px 20px;text-align:center;">
          <div class="card-glow-effect"></div>
          <div style={`width:56px;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-family:'Source Code Pro',monospace;font-weight:700;font-size:0.8rem;background:${c.color}15;color:${c.color};border:1px solid ${c.color}22;margin:0 auto 14px;position:relative;z-index:1;`}>
            {c.icon}
          </div>
          <h3 style="font-weight:600;color:var(--text);font-size:0.95rem;margin-bottom:4px;position:relative;z-index:1;">{c.title}</h3>
          <p style="color:var(--text-muted);font-size:0.8rem;margin-bottom:12px;position:relative;z-index:1;">{c.issuer}</p>
          <div style="font-size:0.7rem;font-family:'Source Code Pro',monospace;color:var(--red);background:var(--bg-tertiary);padding:5px 10px;border-radius:6px;display:inline-block;position:relative;z-index:1;">
            View Details &rarr;
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
