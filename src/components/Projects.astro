---
import Badge from './ui/Badge.astro';

const projects = [
  {
    title: "VulnChain",
    description: "Automated vulnerability scanner with chain detection for complex attack paths in enterprise networks.",
    category: "web",
    tags: ["Python", "API", "Nmap", "Nuclei"],
    github: "https://github.com/0xCyb3rgh0st",
    featured: true,
  },
  {
    title: "ADExploit",
    description: "Active Directory attack framework for red team operations with automated privilege escalation.",
    category: "active-directory",
    tags: ["C#", "Impacket", "BloodHound"],
    github: "https://github.com/0xCyb3rgh0st",
    featured: true,
  },
  {
    title: "HeapLab",
    description: "Custom heap exploitation training environment with vulnerable binaries and automated exploit generation.",
    category: "binary-exploitation",
    tags: ["C", "GDB", "pwntools", "pwndbg"],
    github: "https://github.com/0xCyb3rgh0st",
    featured: false,
  },
  {
    title: "PhishGuard",
    description: "ML-powered phishing detection system analyzing URLs, email headers, and page content in real-time.",
    category: "web",
    tags: ["Python", "TensorFlow", "Flask"],
    github: "https://github.com/0xCyb3rgh0st",
    featured: false,
  },
  {
    title: "PacketSnitch",
    description: "Network forensics tool for deep packet inspection and anomaly detection with automated alerting.",
    category: "network",
    tags: ["Rust", "libpcap", "Zeek"],
    github: "https://github.com/0xCyb3rgh0st",
    featured: false,
  },
  {
    title: "MalwareSandbox",
    description: "Automated malware analysis sandbox with behavioral monitoring and IOC extraction.",
    category: "malware",
    tags: ["Python", "Docker", "YARA"],
    github: "https://github.com/0xCyb3rgh0st",
    featured: true,
  },
];

const categoryColors: Record<string, "green" | "cyan" | "purple" | "red" | "yellow" | "orange"> = {
  "web": "cyan",
  "active-directory": "purple",
  "binary-exploitation": "green",
  "network": "yellow",
  "malware": "red",
  "forensics": "orange",
};
---

<section id="projects" class="py-24 px-6">
  <div class="mx-auto max-w-6xl">
    <p class="section-heading">// projects</p>
    <h2 class="text-3xl md:text-4xl font-bold mb-12">
      <span class="gradient-text">Featured</span> <span class="text-text-primary">Work</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="glass-card p-6 flex flex-col group">
          {project.featured && (
            <div class="flex items-center gap-2 mb-3">
              <div class="w-2 h-2 rounded-full bg-accent-green animate-pulse"></div>
              <span class="text-accent-green text-xs font-mono">FEATURED</span>
            </div>
          )}
          <div class="flex items-center gap-2 mb-3">
            <Badge text={project.category.replace("-", " ")} color={categoryColors[project.category] || "green"} />
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-2 group-hover:text-accent-green transition-colors">
            {project.title}
          </h3>
          <p class="text-text-secondary text-sm mb-4 flex-grow leading-relaxed">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            {project.tags.map((tag) => (
              <span class="text-xs font-mono text-text-secondary bg-bg-tertiary px-2 py-1 rounded">
                {tag}
              </span>
            ))}
          </div>
          <a
            href={project.github}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 text-sm text-accent-green font-mono hover:underline"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
