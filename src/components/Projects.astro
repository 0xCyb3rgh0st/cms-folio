---
const projects = [
  { title: "pwnlibc", desc: "Advanced libc identification toolkit for exploit development. Fast libc identification, automatic download, symbol lookup, Python API, and CLI.", cat: "binary-exploitation", tags: ["Python", "Exploit Dev", "CLI"], featured: true, slug: "pwnlibc" },
  { title: "ghidra-open", desc: "One-command launcher for Ghidra. Binary → Automatic Project → Headless Analysis → Launch GUI. Eliminates repetitive setup tasks.", cat: "reverse-engineering", tags: ["Ghidra", "Automation", "Java"], featured: true, slug: "ghidra-open" },
  { title: "VulnOS", desc: "An open-source workspace for vulnerability research. Workspace management, findings tracking, AI assistant, and plugin system. In development.", cat: "vulnerability-research", tags: ["Python", "AI", "Workspace"], featured: true, slug: "vulnos" },
];
const catColors: Record<string, string> = { "binary-exploitation": "var(--green)", "reverse-engineering": "var(--cyan)", "vulnerability-research": "var(--purple)", "web": "var(--cyan)", "active-directory": "var(--purple)" };
---
<section id="projects" style="padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.875rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// projects</p>
    <h2 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:48px;">
      <span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Flagship</span>
      <span style="color:var(--text);"> Projects</span>
    </h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;">
      {projects.map((p) => (
        <a href={`/projects/${p.slug}`} style="text-decoration:none;display:block;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:24px;transition:all 0.3s;" onmouseover="this.style.borderColor='var(--green)';this.style.transform='translateY(-4px)'" onmouseout="this.style.borderColor='var(--border)';this.style.transform='none'">
          {p.featured && (
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
              <div style="width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);"></div>
              <span style="color:var(--green);font-size:0.7rem;font-family:'JetBrains Mono',monospace;">FLAGSHIP</span>
            </div>
          )}
          <span style={`display:inline-flex;padding:2px 8px;font-size:0.7rem;font-family:'JetBrains Mono',monospace;border-radius:4px;background:${catColors[p.cat]}15;color:${catColors[p.cat]};border:1px solid ${catColors[p.cat]}33;width:fit-content;margin-bottom:12px;text-transform:capitalize;`}>
            {p.cat.replace("-", " ")}
          </span>
          <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:8px;">{p.title}</h3>
          <p style="color:var(--text-muted);font-size:0.875rem;line-height:1.6;margin-bottom:16px;flex-grow:1;">{p.desc}</p>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;">
            {p.tags.map((t) => (
              <span style="font-size:0.7rem;font-family:'JetBrains Mono',monospace;color:var(--text-muted);background:var(--bg-tertiary);padding:3px 8px;border-radius:4px;">{t}</span>
            ))}
          </div>
          <span style="color:var(--green);font-size:0.875rem;font-family:'JetBrains Mono',monospace;">View Details &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
