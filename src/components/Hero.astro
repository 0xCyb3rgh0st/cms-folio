---
---
<section style="position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;">
  <canvas id="matrix-rain" class="hero-parallax" style="position:absolute;inset:0;width:100%;height:100%;opacity:0.06;" aria-hidden="true"></canvas>
  <div class="hero-parallax" style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(10,10,10,0.95) 40%,rgba(10,10,10,0.7) 100%);"></div>
  <div class="crt-overlay" aria-hidden="true"></div>

  <div class="hero-content-parallax" style="position:relative;z-index:10;width:100%;max-width:1200px;margin:0 auto;padding:120px 48px 80px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;">
    
    <!-- Left: Text -->
    <div>
      <p style="font-family:'Source Code Pro',monospace;color:var(--red);font-size:0.8rem;letter-spacing:0.2em;text-transform:uppercase;margin-bottom:16px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.2s;">whoami</p>
      <h1 style="font-size:clamp(2.5rem,6vw,4rem);font-weight:800;margin-bottom:20px;line-height:1.1;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.4s;">
        <span style="color:#ffffff;">Jatin</span>
        <span style="color:#ffffff;"> Singh</span>
      </h1>
      <p style="font-size:1.05rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;margin-bottom:12px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.6s;">
        <span style="color:var(--red);">&gt;</span> <span id="hero-typing"></span><span style="color:var(--red);animation:pulse-glow 1.5s ease-in-out infinite;">_</span>
      </p>
      <p style="font-size:0.95rem;color:var(--text-muted);max-width:500px;line-height:1.8;margin-bottom:36px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.8s;">
        Security researcher. I like finding bugs, writing exploits, and automating things I'm too lazy to do twice.
      </p>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1s;">
        <a href="#projects" style="padding:14px 32px;background:var(--red);color:#fff;font-family:'Source Code Pro',monospace;font-weight:600;border-radius:var(--radius);font-size:0.875rem;transition:all 0.2s ease-in-out;display:inline-flex;align-items:center;gap:8px;" onmouseover="this.style.boxShadow='0 0 24px rgba(239,68,68,0.35)';this.style.transform='translateY(-1px)'" onmouseout="this.style.boxShadow='none';this.style.transform='none'">
          View Projects
          <span class="arrow-hover" style="transition:transform 0.2s ease-in-out;">&rarr;</span>
        </a>
        <a href="#contact" style="padding:14px 32px;border:1px solid var(--border);color:var(--text);font-family:'Source Code Pro',monospace;border-radius:var(--radius);font-size:0.875rem;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text)'">
          Contact Me
        </a>
      </div>
      <p style="margin-top:24px;font-size:0.8rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1.2s;">
        <span style="color:var(--red);">Open to relocation within EU</span> &middot; Eligible for UK/EU work visas
      </p>
    </div>

    <!-- Right: Frame -->
    <div class="hero-frame-wrap" aria-hidden="true">
      <img src="/hero-combined.svg" alt="" width="520" height="520" style="width:100%;max-width:520px;height:auto;" />
    </div>
  </div>

  <div style="position:absolute;bottom:32px;left:50%;transform:translateX(-50%);animation:float 2.5s ease-in-out infinite;z-index:10;" aria-hidden="true">
    <svg width="20" height="20" fill="none" stroke="var(--text-muted)" stroke-width="2" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg>
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const canvas = document.getElementById('matrix-rain') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const chars = '01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
        const fontSize = 14;
        const columns = Math.floor(canvas.width / fontSize);
        const drops: number[] = Array(columns).fill(1);
        function draw() {
          ctx.fillStyle = 'rgba(10, 10, 10, 0.06)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#ef4444';
          ctx.font = `${fontSize}px "Source Code Pro", monospace`;
          for (let i = 0; i < drops.length; i++) {
            const text = chars[Math.floor(Math.random() * chars.length)];
            ctx.globalAlpha = 0.12 + Math.random() * 0.2;
            ctx.fillText(text, i * fontSize, drops[i] * fontSize);
            if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
            drops[i]++;
          }
          ctx.globalAlpha = 1;
          requestAnimationFrame(draw);
        }
        draw();
        window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });
      }
    }
  }

  const typeEl = document.getElementById('hero-typing');
  if (typeEl && !prefersReducedMotion) {
    const phrases = ['Security Researcher & Exploit Developer', 'Binary Exploitation', 'Reverse Engineering', 'Building Open Source Tools', 'Bug Bounty Hunter'];
    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;
    let delay = 100;
    function type() {
      const current = phrases[phraseIdx];
      if (!deleting) {
        typeEl.textContent = current.substring(0, charIdx + 1);
        charIdx++;
        if (charIdx === current.length) { deleting = true; delay = 2000; } else { delay = 80; }
      } else {
        typeEl.textContent = current.substring(0, charIdx - 1);
        charIdx--;
        if (charIdx === 0) { deleting = false; phraseIdx = (phraseIdx + 1) % phrases.length; delay = 400; } else { delay = 40; }
      }
      setTimeout(type, delay);
    }
    type();
  } else if (typeEl) {
    typeEl.textContent = 'Security Researcher & Exploit Developer';
  }
</script>

<style>
  .hero-frame-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
    animation: fadeSlideUp 0.8s ease forwards 0.4s;
  }
  .crt-overlay {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(10, 10, 10, 0.03) 0px,
      rgba(10, 10, 10, 0.03) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
    z-index: 5;
  }
  @media (max-width: 768px) {
    .hero-content-parallax {
      grid-template-columns: 1fr !important;
      padding: 100px 24px 60px !important;
      text-align: center;
    }
    .hero-frame-wrap {
      display: none !important;
    }
  }
</style>
