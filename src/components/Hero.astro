---
---
<section style="position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;">
  <div class="hero-content-parallax" style="position:relative;z-index:10;width:100%;max-width:1200px;margin:0 auto;padding:120px 48px 80px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;">
    
    <!-- Left: Text -->
    <div>
      <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border:1px solid rgba(239,68,68,0.2);border-radius:999px;margin-bottom:24px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.2s;">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red);animation:pulse-glow 2s ease-in-out infinite;"></span>
        <span style="font-family:'Source Code Pro',monospace;color:var(--red);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;">available for hire</span>
      </div>
      <h1 style="font-size:clamp(2.8rem,7vw,4.5rem);font-weight:800;margin-bottom:16px;line-height:1.05;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.4s;">
        <span style="color:#ffffff;">Jatin</span><br/>
        <span style="color:#ffffff;">Singh</span>
      </h1>
      <p style="font-size:1.1rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;margin-bottom:8px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.6s;">
        <span style="color:var(--red);">$</span> <span id="hero-typing"></span><span style="color:var(--red);animation:pulse-glow 1.5s ease-in-out infinite;">_</span>
      </p>
      <p style="font-size:0.95rem;color:var(--text-muted);max-width:480px;line-height:1.8;margin-bottom:36px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.8s;">
        Security researcher. I like finding bugs, writing exploits, and automating things I'm too lazy to do twice.
      </p>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1s;">
        <a href="#projects" style="padding:14px 32px;background:var(--red);color:#fff;font-family:'Source Code Pro',monospace;font-weight:600;border-radius:var(--radius);font-size:0.875rem;transition:all 0.2s ease-in-out;display:inline-flex;align-items:center;gap:8px;" onmouseover="this.style.boxShadow='0 0 30px rgba(239,68,68,0.4)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='none';this.style.transform='none'">
          View Projects
          <span class="arrow-hover" style="transition:transform 0.2s ease-in-out;">&rarr;</span>
        </a>
        <a href="#contact" style="padding:14px 32px;border:1px solid var(--border);color:var(--text);font-family:'Source Code Pro',monospace;border-radius:var(--radius);font-size:0.875rem;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text)'">
          Contact Me
        </a>
      </div>
      <div style="margin-top:28px;display:flex;gap:24px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1.2s;">
        <div style="text-align:center;">
          <p style="font-size:1.5rem;font-weight:700;color:var(--text);">6+</p>
          <p style="font-size:0.7rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">Projects</p>
        </div>
        <div style="width:1px;background:var(--border);"></div>
        <div style="text-align:center;">
          <p style="font-size:1.5rem;font-weight:700;color:var(--text);">5</p>
          <p style="font-size:0.7rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">Certs</p>
        </div>
        <div style="width:1px;background:var(--border);"></div>
        <div style="text-align:center;">
          <p style="font-size:1.5rem;font-weight:700;color:var(--text);">NASA</p>
          <p style="font-size:0.7rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">Recognized</p>
        </div>
      </div>
    </div>

    <!-- Right: Avatar with orbiting rings and icons -->
    <div class="hero-avatar-wrap" style="position:relative;display:flex;align-items:center;justify-content:center;opacity:0;animation:fadeSlideUp 0.8s ease forwards 0.5s;">
      <canvas id="avatar-orbit" style="position:absolute;inset:-100px;width:calc(100% + 200px);height:calc(100% + 200px);z-index:1;pointer-events:none;" aria-hidden="true"></canvas>
      <!-- Glow -->
      <div style="position:absolute;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(239,68,68,0.07) 0%,transparent 70%);filter:blur(30px);pointer-events:none;z-index:0;" aria-hidden="true"></div>
      <!-- Avatar -->
      <img src="/avatar.svg" alt="Jatin Singh" width="300" height="300" style="width:300px;height:300px;border-radius:50%;border:2px solid rgba(239,68,68,0.2);box-shadow:0 0 50px rgba(239,68,68,0.12),0 0 100px rgba(239,68,68,0.05);position:relative;z-index:2;" />
      <!-- Status dot -->
      <div style="position:absolute;bottom:40px;right:60px;width:16px;height:16px;border-radius:50%;background:#22c55e;border:3px solid var(--bg-primary);box-shadow:0 0 8px rgba(34,197,94,0.5);z-index:3;"></div>
      <!-- Data labels -->
      <div style="position:absolute;top:10px;right:-30px;z-index:3;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1s;">
        <div style="background:rgba(10,10,10,0.85);border:1px solid rgba(239,68,68,0.12);border-radius:8px;padding:10px 14px;font-family:'Source Code Pro',monospace;font-size:0.65rem;backdrop-filter:blur(8px);">
          <p style="color:var(--red);margin-bottom:4px;">LOCATION</p>
          <p style="color:var(--text-muted);">Kathmandu, NP</p>
        </div>
      </div>
      <div style="position:absolute;bottom:20px;left:-20px;z-index:3;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1.2s;">
        <div style="background:rgba(10,10,10,0.85);border:1px solid rgba(239,68,68,0.12);border-radius:8px;padding:10px 14px;font-family:'Source Code Pro',monospace;font-size:0.65rem;backdrop-filter:blur(8px);">
          <p style="color:var(--red);margin-bottom:4px;">CLEARANCE</p>
          <p style="color:var(--text-muted);">CRTA | CPTS</p>
        </div>
      </div>
    </div>
  </div>

  <div style="position:absolute;bottom:32px;left:50%;transform:translateX(-50%);animation:float 2.5s ease-in-out infinite;z-index:10;" aria-hidden="true">
    <svg width="20" height="20" fill="none" stroke="var(--text-muted)" stroke-width="2" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg>
  </div>
</section>

<script is:inline>
(function() {
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Typing effect
  const typeEl = document.getElementById('hero-typing');
  if (typeEl && !prefersReducedMotion) {
    const phrases = ['security researcher & exploit developer', 'binary exploitation', 'reverse engineering', 'building open source tools', 'bug bounty hunter'];
    let phraseIdx = 0, charIdx = 0, deleting = false, delay = 100;
    function type() {
      const current = phrases[phraseIdx];
      if (!deleting) {
        typeEl.textContent = current.substring(0, charIdx + 1);
        charIdx++;
        if (charIdx === current.length) { deleting = true; delay = 2000; } else { delay = 80; }
      } else {
        typeEl.textContent = current.substring(0, charIdx - 1);
        charIdx--;
        if (charIdx === 0) { deleting = false; phraseIdx = (phraseIdx + 1) % phrases.length; delay = 400; } else { delay = 40; }
      }
      setTimeout(type, delay);
    }
    type();
  } else if (typeEl) {
    typeEl.textContent = 'security researcher & exploit developer';
  }

  // Orbiting rings and icons
  if (prefersReducedMotion) return;
  const canvas = document.getElementById('avatar-orbit');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let w, h;
  function resize() {
    const rect = canvas.parentElement.getBoundingClientRect();
    w = canvas.width = rect.width + 200;
    h = canvas.height = rect.height + 200;
  }
  resize();
  window.addEventListener('resize', resize);

  const cx = () => w / 2;
  const cy = () => h / 2;
  let time = 0;

  // Orbiting tech icons (SVG paths)
  const icons = [
    { angle: 0, radius: 180, speed: 0.008, label: '< />', size: 10 },
    { angle: Math.PI * 0.5, radius: 180, speed: 0.008, label: '{ }', size: 10 },
    { angle: Math.PI, radius: 180, speed: 0.008, label: '[ ]', size: 10 },
    { angle: Math.PI * 1.5, radius: 180, speed: 0.008, label: '( )', size: 10 },
    { angle: 0.3, radius: 220, speed: -0.005, label: '0x', size: 9 },
    { angle: Math.PI * 0.3 + 0.3, radius: 220, speed: -0.005, label: '*/', size: 9 },
    { angle: Math.PI * 0.6 + 0.3, radius: 220, speed: -0.005, label: '$', size: 9 },
    { angle: Math.PI * 0.9 + 0.3, radius: 220, speed: -0.005, label: '#', size: 9 },
    { angle: Math.PI * 1.2 + 0.3, radius: 220, speed: -0.005, label: '@', size: 9 },
    { angle: Math.PI * 1.5 + 0.3, radius: 220, speed: -0.005, label: '&', size: 9 },
  ];

  // Floating particles
  const particles = [];
  for (let i = 0; i < 40; i++) {
    const angle = Math.random() * Math.PI * 2;
    const radius = 140 + Math.random() * 120;
    particles.push({
      angle, radius,
      speed: (0.001 + Math.random() * 0.003) * (Math.random() > 0.5 ? 1 : -1),
      size: 0.5 + Math.random() * 1.5,
      alpha: 0.08 + Math.random() * 0.15,
      drift: Math.random() * 0.3,
    });
  }

  function drawRing(radius, alpha, dash) {
    ctx.beginPath();
    if (dash) {
      ctx.setLineDash(dash);
    }
    ctx.arc(cx(), cy(), radius, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(239, 68, 68, ${alpha})`;
    ctx.lineWidth = 0.8;
    ctx.stroke();
    ctx.setLineDash([]);
  }

  function draw() {
    ctx.clearRect(0, 0, w, h);
    time += 0.01;

    // Ring 1 — solid thin
    drawRing(170, 0.08 + Math.sin(time) * 0.02, null);

    // Ring 2 — dashed
    drawRing(195, 0.06, [4, 6]);

    // Ring 3 — dotted effect via segments
    ctx.beginPath();
    ctx.arc(cx(), cy(), 220, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(239, 68, 68, 0.05)';
    ctx.lineWidth = 12;
    ctx.stroke();
    ctx.lineWidth = 1;

    // Rotating arc segments on ring 2
    for (let i = 0; i < 4; i++) {
      const startAngle = time * 0.5 + (Math.PI * 2 / 4) * i;
      ctx.beginPath();
      ctx.arc(cx(), cy(), 195, startAngle, startAngle + 0.4);
      ctx.strokeStyle = 'rgba(239, 68, 68, 0.2)';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.lineWidth = 1;
    }

    // Counter-rotating arcs on outer ring
    for (let i = 0; i < 3; i++) {
      const startAngle = -time * 0.3 + (Math.PI * 2 / 3) * i;
      ctx.beginPath();
      ctx.arc(cx(), cy(), 220, startAngle, startAngle + 0.6);
      ctx.strokeStyle = 'rgba(239, 68, 68, 0.12)';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.lineWidth = 1;
    }

    // Floating particles
    particles.forEach(p => {
      p.angle += p.speed;
      const r = p.radius + Math.sin(time * 2 + p.angle) * p.drift * 8;
      const x = cx() + Math.cos(p.angle) * r;
      const y = cy() + Math.sin(p.angle) * r;
      ctx.beginPath();
      ctx.arc(x, y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(239, 68, 68, ${p.alpha})`;
      ctx.fill();
    });

    // Orbiting icons
    icons.forEach(icon => {
      icon.angle += icon.speed;
      const x = cx() + Math.cos(icon.angle) * icon.radius;
      const y = cy() + Math.sin(icon.angle) * icon.radius;

      // Icon background
      ctx.beginPath();
      ctx.arc(x, y, 14, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(10, 10, 10, 0.8)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(239, 68, 68, 0.2)';
      ctx.lineWidth = 0.8;
      ctx.stroke();
      ctx.lineWidth = 1;

      // Icon text
      ctx.font = `${icon.size}px "Source Code Pro", monospace`;
      ctx.fillStyle = 'rgba(239, 68, 68, 0.6)';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(icon.label, x, y);
    });

    // Pulse ring
    const pulseR = 170 + Math.sin(time * 2) * 5;
    ctx.beginPath();
    ctx.arc(cx(), cy(), pulseR, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(239, 68, 68, ${0.03 + Math.sin(time * 2) * 0.015})`;
    ctx.lineWidth = 1;
    ctx.stroke();

    requestAnimationFrame(draw);
  }
  draw();
})();
</script>

<style>
  @media (max-width: 768px) {
    .hero-content-parallax {
      grid-template-columns: 1fr !important;
      padding: 100px 24px 60px !important;
      text-align: center;
    }
    .hero-avatar-wrap {
      display: none !important;
    }
  }
</style>
