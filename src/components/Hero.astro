---
---
<section style="position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;">
  <div class="hero-content-parallax" style="position:relative;z-index:10;width:100%;max-width:1200px;margin:0 auto;padding:120px 48px 80px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;">
    
    <!-- Left: Text -->
    <div>
      <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border:1px solid rgba(239,68,68,0.2);border-radius:999px;margin-bottom:24px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.2s;">
        <span style="width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 8px var(--red);animation:pulse-glow 2s ease-in-out infinite;"></span>
        <span style="font-family:'Source Code Pro',monospace;color:var(--red);font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;">available for hire</span>
      </div>
      <h1 style="font-size:clamp(2.8rem,7vw,4.5rem);font-weight:800;margin-bottom:16px;line-height:1.05;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.4s;">
        <span style="color:#ffffff;">Jatin</span><br/>
        <span style="color:#ffffff;">Singh</span>
      </h1>
      <p style="font-size:1.1rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;margin-bottom:8px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.6s;">
        <span style="color:var(--red);">$</span> <span id="hero-typing"></span><span style="color:var(--red);animation:pulse-glow 1.5s ease-in-out infinite;">_</span>
      </p>
      <p style="font-size:0.95rem;color:var(--text-muted);max-width:480px;line-height:1.8;margin-bottom:36px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 0.8s;">
        Security researcher. I like finding bugs, writing exploits, and automating things I'm too lazy to do twice.
      </p>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1s;">
        <a href="#projects" style="padding:14px 32px;background:var(--red);color:#fff;font-family:'Source Code Pro',monospace;font-weight:600;border-radius:var(--radius);font-size:0.875rem;transition:all 0.2s ease-in-out;display:inline-flex;align-items:center;gap:8px;" onmouseover="this.style.boxShadow='0 0 30px rgba(239,68,68,0.4)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='none';this.style.transform='none'">
          View Projects
          <span class="arrow-hover" style="transition:transform 0.2s ease-in-out;">&rarr;</span>
        </a>
        <a href="#contact" style="padding:14px 32px;border:1px solid var(--border);color:var(--text);font-family:'Source Code Pro',monospace;border-radius:var(--radius);font-size:0.875rem;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--red)';this.style.color='var(--red)'" onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text)'">
          Contact Me
        </a>
      </div>
      <div style="margin-top:28px;display:flex;gap:24px;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1.2s;">
        <div style="text-align:center;">
          <p style="font-size:1.5rem;font-weight:700;color:var(--text);">6+</p>
          <p style="font-size:0.7rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">Projects</p>
        </div>
        <div style="width:1px;background:var(--border);"></div>
        <div style="text-align:center;">
          <p style="font-size:1.5rem;font-weight:700;color:var(--text);">5</p>
          <p style="font-size:0.7rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">Certs</p>
        </div>
        <div style="width:1px;background:var(--border);"></div>
        <div style="text-align:center;">
          <p style="font-size:1.5rem;font-weight:700;color:var(--text);">NASA</p>
          <p style="font-size:0.7rem;color:var(--text-muted);font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">Recognized</p>
        </div>
      </div>
    </div>

    <!-- Right: Interstellar black hole avatar -->
    <div class="hero-avatar-wrap" style="position:relative;display:flex;align-items:center;justify-content:center;opacity:0;animation:fadeSlideUp 0.8s ease forwards 0.5s;">
      <canvas id="blackhole" style="position:absolute;inset:-120px;width:calc(100% + 240px);height:calc(100% + 240px);z-index:1;pointer-events:none;" aria-hidden="true"></canvas>
      <!-- Avatar in the singularity -->
      <img src="/avatar.svg" alt="Jatin Singh" width="200" height="200" style="width:200px;height:200px;border-radius:50%;position:relative;z-index:3;filter:drop-shadow(0 0 20px rgba(239,68,68,0.3));" />
      <!-- Status dot -->
      <div style="position:absolute;bottom:60px;right:80px;width:14px;height:14px;border-radius:50%;background:#22c55e;border:3px solid var(--bg-primary);box-shadow:0 0 10px rgba(34,197,94,0.6);z-index:5;"></div>
      <!-- Data labels -->
      <div style="position:absolute;top:0;right:-40px;z-index:5;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1s;">
        <div style="background:rgba(10,10,10,0.9);border:1px solid rgba(239,68,68,0.12);border-radius:8px;padding:10px 14px;font-family:'Source Code Pro',monospace;font-size:0.65rem;backdrop-filter:blur(8px);">
          <p style="color:var(--red);margin-bottom:4px;">LOCATION</p>
          <p style="color:var(--text-muted);">Kathmandu, NP</p>
        </div>
      </div>
      <div style="position:absolute;bottom:10px;left:-30px;z-index:5;opacity:0;animation:fadeSlideUp 0.6s ease forwards 1.2s;">
        <div style="background:rgba(10,10,10,0.9);border:1px solid rgba(239,68,68,0.12);border-radius:8px;padding:10px 14px;font-family:'Source Code Pro',monospace;font-size:0.65rem;backdrop-filter:blur(8px);">
          <p style="color:var(--red);margin-bottom:4px;">CLEARANCE</p>
          <p style="color:var(--text-muted);">CRTA | CPTS</p>
        </div>
      </div>
    </div>
  </div>

  <div style="position:absolute;bottom:32px;left:50%;transform:translateX(-50%);animation:float 2.5s ease-in-out infinite;z-index:10;" aria-hidden="true">
    <svg width="20" height="20" fill="none" stroke="var(--text-muted)" stroke-width="2" aria-hidden="true"><path d="M4 7l6 6 6-6" /></svg>
  </div>
</section>

<script is:inline>
(function() {
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Typing
  const typeEl = document.getElementById('hero-typing');
  if (typeEl && !prefersReducedMotion) {
    const phrases = ['security researcher & exploit developer', 'binary exploitation', 'reverse engineering', 'building open source tools', 'bug bounty hunter'];
    let phraseIdx = 0, charIdx = 0, deleting = false, delay = 100;
    function type() {
      const c = phrases[phraseIdx];
      if (!deleting) { typeEl.textContent = c.substring(0, charIdx + 1); charIdx++; delay = charIdx === c.length ? (deleting = true, 2000) : 80; }
      else { typeEl.textContent = c.substring(0, charIdx - 1); charIdx--; if (charIdx === 0) { deleting = false; phraseIdx = (phraseIdx + 1) % phrases.length; delay = 400; } else delay = 40; }
      setTimeout(type, delay);
    }
    type();
  } else if (typeEl) { typeEl.textContent = 'security researcher & exploit developer'; }

  if (prefersReducedMotion) return;
  const canvas = document.getElementById('blackhole');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let w, h;
  function resize() {
    const r = canvas.parentElement.getBoundingClientRect();
    w = canvas.width = r.width + 240;
    h = canvas.height = r.height + 240;
  }
  resize();
  window.addEventListener('resize', resize);

  const CX = () => w / 2;
  const CY = () => h / 2;
  let t = 0;

  // Accretion disk particles
  const diskParticles = [];
  for (let i = 0; i < 300; i++) {
    const angle = Math.random() * Math.PI * 2;
    const radius = 110 + Math.random() * 100;
    const speed = 0.003 + (1 - (radius - 110) / 100) * 0.008;
    diskParticles.push({ angle, radius, speed, size: 0.5 + Math.random() * 2, alpha: 0.1 + Math.random() * 0.5, layer: Math.random() });
  }

  // Lensing particles (light bending around the back)
  const lensParticles = [];
  for (let i = 0; i < 120; i++) {
    const angle = Math.random() * Math.PI * 2;
    const radius = 95 + Math.random() * 30;
    lensParticles.push({ angle, radius, speed: 0.002 + Math.random() * 0.004, size: 0.3 + Math.random() * 1, alpha: 0.05 + Math.random() * 0.15 });
  }

  // Orbiting tech icons
  const icons = [
    { angle: 0, r: 200, speed: 0.006, label: '< />' },
    { angle: Math.PI * 0.5, r: 200, speed: 0.006, label: '{ }' },
    { angle: Math.PI, r: 200, speed: 0.006, label: '[ ]' },
    { angle: Math.PI * 1.5, r: 200, speed: 0.006, label: '( )' },
    { angle: 0.4, r: 240, speed: -0.004, label: '0x' },
    { angle: Math.PI * 0.4 + 0.4, r: 240, speed: -0.004, label: '*/' },
    { angle: Math.PI * 0.8 + 0.4, r: 240, speed: -0.004, label: '#' },
    { angle: Math.PI * 1.2 + 0.4, r: 240, speed: -0.004, label: '@' },
  ];

  function draw() {
    ctx.clearRect(0, 0, w, h);
    t += 0.008;
    const cx = CX(), cy = CY();

    // Outer glow — the event horizon
    const g0 = ctx.createRadialGradient(cx, cy, 60, cx, cy, 260);
    g0.addColorStop(0, 'rgba(239, 68, 68, 0.02)');
    g0.addColorStop(0.3, 'rgba(239, 68, 68, 0.06)');
    g0.addColorStop(0.6, 'rgba(239, 68, 68, 0.03)');
    g0.addColorStop(1, 'rgba(239, 68, 68, 0)');
    ctx.fillStyle = g0;
    ctx.beginPath();
    ctx.arc(cx, cy, 260, 0, Math.PI * 2);
    ctx.fill();

    // Accretion disk — back half (behind the black hole)
    ctx.save();
    ctx.beginPath();
    ctx.rect(cx - 260, cy - 260, 520, 260);
    ctx.clip();
    drawAccretionDisk(cx, cy, 0.7);
    ctx.restore();

    // Gravitational lensing ring (light bending)
    for (const p of lensParticles) {
      p.angle += p.speed;
      const x = cx + Math.cos(p.angle) * p.radius;
      const y = cy + Math.sin(p.angle) * p.radius * 0.35;
      const warp = Math.sin(p.angle * 3 + t) * 3;
      ctx.beginPath();
      ctx.arc(x + warp, y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 120, 80, ${p.alpha * (0.5 + Math.sin(t + p.angle) * 0.5)})`;
      ctx.fill();
    }

    // Black hole center — event horizon
    const g1 = ctx.createRadialGradient(cx, cy, 0, cx, cy, 85);
    g1.addColorStop(0, 'rgba(0, 0, 0, 1)');
    g1.addColorStop(0.7, 'rgba(0, 0, 0, 0.98)');
    g1.addColorStop(0.9, 'rgba(15, 10, 10, 0.9)');
    g1.addColorStop(1, 'rgba(239, 68, 68, 0.15)');
    ctx.fillStyle = g1;
    ctx.beginPath();
    ctx.arc(cx, cy, 85, 0, Math.PI * 2);
    ctx.fill();

    // Photon ring — bright thin ring at event horizon edge
    ctx.beginPath();
    ctx.arc(cx, cy, 85, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(255, 100, 60, ${0.3 + Math.sin(t * 2) * 0.1})`;
    ctx.lineWidth = 2;
    ctx.stroke();

    // Second photon ring
    ctx.beginPath();
    ctx.arc(cx, cy, 90, 0, Math.PI * 2);
    ctx.strokeStyle = `rgba(239, 68, 68, ${0.12 + Math.sin(t * 1.5) * 0.05})`;
    ctx.lineWidth = 1;
    ctx.stroke();

    // Accretion disk — front half (in front of the black hole)
    ctx.save();
    ctx.beginPath();
    ctx.rect(cx - 260, cy, 520, 260);
    ctx.clip();
    drawAccretionDisk(cx, cy, 1);
    ctx.restore();

    // Accretion disk tilted ring (like Interstellar's perspective)
    drawTiltedDisk(cx, cy);

    // Orbiting icons
    for (const icon of icons) {
      icon.angle += icon.speed;
      const x = cx + Math.cos(icon.angle) * icon.r;
      const y = cy + Math.sin(icon.angle) * icon.r * 0.4;
      const depth = (Math.sin(icon.angle) + 1) / 2;
      const alpha = 0.2 + depth * 0.4;
      const sz = 8 + depth * 4;

      ctx.beginPath();
      ctx.arc(x, y, sz, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(10, 10, 10, ${0.7 + depth * 0.2})`;
      ctx.fill();
      ctx.strokeStyle = `rgba(239, 68, 68, ${alpha * 0.5})`;
      ctx.lineWidth = 0.8;
      ctx.stroke();

      ctx.font = `${7 + depth * 2}px "Source Code Pro", monospace`;
      ctx.fillStyle = `rgba(239, 68, 68, ${alpha})`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(icon.label, x, y);
    }

    // Orbit trails
    ctx.beginPath();
    ctx.ellipse(cx, cy, 200, 80, 0, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(239, 68, 68, 0.04)';
    ctx.lineWidth = 0.5;
    ctx.stroke();

    ctx.beginPath();
    ctx.ellipse(cx, cy, 240, 96, 0, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(239, 68, 68, 0.03)';
    ctx.stroke();

    requestAnimationFrame(draw);
  }

  function drawAccretionDisk(cx, cy, globalAlpha) {
    for (const p of diskParticles) {
      p.angle += p.speed;
      const x = cx + Math.cos(p.angle) * p.radius;
      const y = cy + Math.sin(p.angle) * p.radius * 0.38;
      const depth = (Math.sin(p.angle) + 1) / 2;
      const flicker = 0.6 + Math.sin(t * 3 + p.angle * 2) * 0.4;
      const a = p.alpha * depth * flicker * globalAlpha;

      // Color varies by distance — inner is brighter/whiter, outer is redder
      const inner = p.radius < 150;
      const r = inner ? 255 : 239;
      const g = inner ? 100 + (1 - depth) * 80 : 68;
      const b = inner ? 60 : 68;

      ctx.beginPath();
      ctx.arc(x, y, p.size * (0.5 + depth * 0.5), 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${a})`;
      ctx.fill();
    }
  }

  function drawTiltedDisk(cx, cy) {
    // The iconic tilted accretion disk ring
    for (let i = 0; i < 60; i++) {
      const angle = (Math.PI * 2 / 60) * i + t * 0.3;
      const rx = 150, ry = 55;
      const x = cx + Math.cos(angle) * rx;
      const y = cy + Math.sin(angle) * ry;
      const nextAngle = angle + 0.12;
      const nx = cx + Math.cos(nextAngle) * rx;
      const ny = cy + Math.sin(nextAngle) * ry;

      const depth = (Math.sin(angle) + 1) / 2;
      const bright = 0.08 + depth * 0.15;
      const flicker = 0.7 + Math.sin(t * 2 + i * 0.5) * 0.3;

      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(nx, ny);
      ctx.strokeStyle = `rgba(255, 80, 40, ${bright * flicker})`;
      ctx.lineWidth = 1.5 + depth;
      ctx.stroke();
    }
  }

  draw();
})();
</script>

<style>
  @media (max-width: 768px) {
    .hero-content-parallax {
      grid-template-columns: 1fr !important;
      padding: 100px 24px 60px !important;
      text-align: center;
    }
    .hero-avatar-wrap {
      display: none !important;
    }
  }
</style>
