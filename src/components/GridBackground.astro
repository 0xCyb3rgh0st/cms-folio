---
---
<canvas id="grid-bg" style="position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;" aria-hidden="true"></canvas>

<script is:inline>
(function() {
  const canvas = document.getElementById('grid-bg');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let w, h;
  let mouseX = -1000, mouseY = -1000;
  let targetX = -1000, targetY = -1000;
  let isHovering = false;
  const gridSize = 40;
  const glowRadius = 350;
  let glowIntensity = 0;
  let ripples = [];

  function resize() {
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  if (!prefersReducedMotion) {
    document.addEventListener('mousemove', function(e) {
      targetX = e.clientX;
      targetY = e.clientY;
      isHovering = true;
    });
    document.addEventListener('mouseleave', function() {
      isHovering = false;
    });
  }

  function draw() {
    ctx.clearRect(0, 0, w, h);

    // Smooth follow
    mouseX += (targetX - mouseX) * 0.06;
    mouseY += (targetY - mouseY) * 0.06;

    // Glow intensity fade
    if (isHovering) {
      glowIntensity += (1 - glowIntensity) * 0.04;
    } else {
      glowIntensity += (0 - glowIntensity) * 0.03;
    }

    // Draw grid lines — brighter near cursor
    const lineStep = gridSize;
    for (let x = 0; x <= w; x += lineStep) {
      const dx = x - mouseX;
      const distX = Math.abs(dx);
      const brightX = distX < glowRadius ? (1 - distX / glowRadius) * glowIntensity : 0;
      const alpha = 0.03 + brightX * 0.12;
      ctx.strokeStyle = `rgba(239, 68, 68, ${alpha})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    for (let y = 0; y <= h; y += lineStep) {
      const dy = y - mouseY;
      const distY = Math.abs(dy);
      const brightY = distY < glowRadius ? (1 - distY / glowRadius) * glowIntensity : 0;
      const alpha = 0.03 + brightY * 0.12;
      ctx.strokeStyle = `rgba(239, 68, 68, ${alpha})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    // Major grid lines (every 5 cells)
    for (let x = 0; x <= w; x += gridSize * 5) {
      const dx = x - mouseX;
      const distX = Math.abs(dx);
      const brightX = distX < glowRadius ? (1 - distX / glowRadius) * glowIntensity : 0;
      ctx.strokeStyle = `rgba(239, 68, 68, ${0.05 + brightX * 0.15})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    for (let y = 0; y <= h; y += gridSize * 5) {
      const dy = y - mouseY;
      const distY = Math.abs(dy);
      const brightY = distY < glowRadius ? (1 - distY / glowRadius) * glowIntensity : 0;
      ctx.strokeStyle = `rgba(239, 68, 68, ${0.05 + brightY * 0.15})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    // Hover glow — big radial spread
    if (glowIntensity > 0.01) {
      const g1 = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, glowRadius);
      g1.addColorStop(0, `rgba(239, 68, 68, ${0.18 * glowIntensity})`);
      g1.addColorStop(0.2, `rgba(239, 68, 68, ${0.10 * glowIntensity})`);
      g1.addColorStop(0.5, `rgba(239, 68, 68, ${0.04 * glowIntensity})`);
      g1.addColorStop(1, 'rgba(239, 68, 68, 0)');
      ctx.fillStyle = g1;
      ctx.fillRect(mouseX - glowRadius, mouseY - glowRadius, glowRadius * 2, glowRadius * 2);

      // Extra inner bright spot
      const g2 = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, 80);
      g2.addColorStop(0, `rgba(239, 68, 68, ${0.15 * glowIntensity})`);
      g2.addColorStop(1, 'rgba(239, 68, 68, 0)');
      ctx.fillStyle = g2;
      ctx.fillRect(mouseX - 80, mouseY - 80, 160, 160);
    }

    // Intersection dots — bigger and brighter near cursor
    if (glowIntensity > 0.01) {
      const startCol = Math.floor((mouseX - glowRadius) / gridSize);
      const endCol = Math.ceil((mouseX + glowRadius) / gridSize);
      const startRow = Math.floor((mouseY - glowRadius) / gridSize);
      const endRow = Math.ceil((mouseY + glowRadius) / gridSize);

      for (let col = startCol; col <= endCol; col++) {
        for (let row = startRow; row <= endRow; row++) {
          const ix = col * gridSize;
          const iy = row * gridSize;
          const dx = ix - mouseX;
          const dy = iy - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < glowRadius) {
            const t = 1 - dist / glowRadius;
            const alpha = t * 0.7 * glowIntensity;
            const size = t * 4 + 0.8;
            ctx.beginPath();
            ctx.arc(ix, iy, size, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(239, 68, 68, ${alpha})`;
            ctx.fill();
          }
        }
      }
    }

    // Ripple rings that spread from cursor
    if (isHovering && Math.random() > 0.96) {
      ripples.push({ x: mouseX, y: mouseY, r: 5, alpha: 0.25 });
    }
    for (let i = ripples.length - 1; i >= 0; i--) {
      const rip = ripples[i];
      rip.r += 2.5;
      rip.alpha -= 0.003;
      if (rip.alpha <= 0 || rip.r > glowRadius) {
        ripples.splice(i, 1);
        continue;
      }
      ctx.beginPath();
      ctx.arc(rip.x, rip.y, rip.r, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(239, 68, 68, ${rip.alpha})`;
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    requestAnimationFrame(draw);
  }

  if (!prefersReducedMotion) {
    draw();
  } else {
    ctx.strokeStyle = 'rgba(239, 68, 68, 0.04)';
    ctx.lineWidth = 1;
    for (let x = 0; x <= w; x += gridSize) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
    }
    for (let y = 0; y <= h; y += gridSize) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
    }
  }
})();
</script>
