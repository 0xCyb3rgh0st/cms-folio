---
const toolCategories = [
  { name: "Reverse Engineering", tools: [{ name: "Ghidra", level: 5 }, { name: "IDA Pro", level: 4 }, { name: "Frida", level: 5 }, { name: "WinDbg", level: 4 }], color: "var(--cyan)", tags: ["ghida", "ida", "frida", "windbg", "pwndbg"] },
  { name: "Offensive Security", tools: [{ name: "Burp Suite", level: 5 }, { name: "Nuclei", level: 5 }, { name: "Impacket", level: 5 }, { name: "BloodHound", level: 5 }], color: "var(--purple)", tags: ["burp", "nuclei", "impacket", "bloodhound", "certipy"] },
  { name: "Exploitation", tools: [{ name: "Sliver", level: 4 }, { name: "Metasploit", level: 5 }, { name: "Certipy", level: 5 }, { name: "Nmap", level: 5 }], color: "var(--green)", tags: ["sliver", "msf", "certipy", "nmap", "ffuf"] },
  { name: "Infrastructure", tools: [{ name: "Docker", level: 5 }, { name: "Linux", level: 5 }, { name: "PostgreSQL", level: 3 }, { name: "GitHub Actions", level: 4 }], color: "var(--yellow)", tags: ["docker", "linux", "postgres", "redis", "gh-actions"] },
];
---
<section id="tools" style="padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.875rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// tools</p>
    <h2 style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;margin-bottom:48px;">
      <span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Toolbox</span>
    </h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
      {toolCategories.map((cat) => (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:24px;" onmouseover="this.style.borderColor='var(--green)'" onmouseout="this.style.borderColor='var(--border)'">
          <h3 style="font-weight:700;color:var(--text);margin-bottom:16px;font-family:'JetBrains Mono',monospace;font-size:0.95rem;">{cat.name}</h3>
          <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:16px;">
            {cat.tools.map((tool) => (
              <div>
                <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                  <span style="color:var(--text-muted);font-size:0.8rem;font-family:'JetBrains Mono',monospace;">{tool.name}</span>
                  <span style="color:var(--text-muted);font-size:0.75rem;font-family:'JetBrains Mono',monospace;">{tool.level}/5</span>
                </div>
                <div style="height:6px;background:var(--bg-tertiary);border-radius:3px;overflow:hidden;">
                  <div style={`height:100%;width:${(tool.level / 5) * 100}%;background:${cat.color};border-radius:3px;box-shadow:0 0 8px ${cat.color};`}></div>
                </div>
              </div>
            ))}
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            {cat.tags.map((tag) => (
              <span style={`display:inline-flex;padding:2px 8px;font-size:0.7rem;font-family:'JetBrains Mono',monospace;border-radius:4px;background:${cat.color}15;color:${cat.color};border:1px solid ${cat.color}33;`}>{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
