---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { projects, getBySlug, getRelated, categoryLabel, categoryColor } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getBySlug(slug!);
if (!project) {
  return Astro.redirect('/projects');
}
const related = getRelated(project, 3);
const catColor = categoryColor(project.category);
---
<BaseLayout title={`${project.title} | Jatin Singh`} description={project.description}>
  <Navigation />
  <main id="main-content" style="padding-top:120px;padding-bottom:64px;">
    <div style="max-width:800px;margin:0 auto;padding:0 24px;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="font-family:'Source Code Pro',monospace;font-size:0.8rem;color:var(--text-muted);margin-bottom:24px;">
        <a href="/" style="color:var(--text-muted);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text-muted)'">Home</a>
        <span style="margin:0 8px;opacity:0.5;">/</span>
        <a href="/projects" style="color:var(--text-muted);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text-muted)'">Projects</a>
        <span style="margin:0 8px;opacity:0.5;">/</span>
        <span style="color:var(--red);">{project.title}</span>
      </nav>

      <div style="margin-bottom:32px;">
        <div style="display:flex;gap:6px;margin-bottom:14px;">
          <span style={`display:inline-flex;padding:4px 12px;font-size:0.7rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:${catColor}15;color:${catColor};border:1px solid ${catColor}22;text-transform:uppercase;letter-spacing:0.1em;`}>{categoryLabel(project.category)}</span>
          {project.featured && (
            <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 12px;font-size:0.7rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:var(--red)15;color:var(--red);border:1px solid var(--red)22;letter-spacing:0.1em;">
              <span style="width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 6px var(--red);"></span>FEATURED
            </span>
          )}
        </div>
        <h1 style="font-size:clamp(1.8rem,4vw,2.4rem);font-weight:700;color:var(--text);margin-bottom:12px;line-height:1.25;font-family:'Source Code Pro',monospace;">{project.title}</h1>
        <p style="font-size:1.05rem;color:var(--text-muted);line-height:1.7;">{project.description}</p>
        <p style="color:var(--text-muted);font-size:0.8rem;font-family:'Source Code Pro',monospace;margin-top:12px;">{project.publishedAt}</p>
      </div>

      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:40px;">
        {project.tags.map((t) => (
          <span style="display:inline-flex;padding:3px 10px;font-size:0.7rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:var(--bg-tertiary);color:var(--text-muted);">#{t}</span>
        ))}
      </div>

      {project.whyItMatters && (
        <section style="margin-bottom:40px;padding:24px;background:var(--bg-secondary);border:1px solid var(--border);border-radius:var(--radius);border-left:3px solid var(--red);">
          <h2 style="font-size:0.9rem;font-weight:600;color:var(--red);margin-bottom:8px;font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">// why it matters</h2>
          <p style="color:var(--text-muted);line-height:1.7;font-size:0.95rem;">{project.whyItMatters}</p>
        </section>
      )}

      {project.impact && (
        <section style="margin-bottom:40px;padding:24px;background:var(--bg-secondary);border:1px solid var(--border);border-radius:var(--radius);border-left:3px solid var(--cyan);">
          <h2 style="font-size:0.9rem;font-weight:600;color:var(--cyan);margin-bottom:8px;font-family:'Source Code Pro',monospace;text-transform:uppercase;letter-spacing:0.1em;">// impact</h2>
          <p style="color:var(--text-muted);line-height:1.7;font-size:0.95rem;">{project.impact}</p>
        </section>
      )}

      <section style="margin-bottom:40px;">
        <h2 style="font-size:1.25rem;font-weight:600;color:var(--text);margin-bottom:16px;font-family:'Source Code Pro',monospace;">
          <span style="color:var(--red);">//</span> Features
        </h2>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:10px;">
          {project.features.map((f) => (
            <li style="display:flex;align-items:flex-start;gap:12px;color:var(--text-muted);line-height:1.6;font-size:0.9rem;">
              <span style="color:var(--red);margin-top:4px;flex-shrink:0;">&#10003;</span>
              {f}
            </li>
          ))}
        </ul>
      </section>

      <section style="margin-bottom:40px;">
        <h2 style="font-size:1.25rem;font-weight:600;color:var(--text);margin-bottom:16px;font-family:'Source Code Pro',monospace;">
          <span style="color:var(--red);">//</span> Tech Stack
        </h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {project.technologies.map((t) => (
            <span style="display:inline-flex;padding:5px 12px;font-size:0.8rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:var(--bg-card);color:var(--text);border:1px solid var(--border);">{t}</span>
          ))}
        </div>
      </section>

      {project.install && (
        <section style="margin-bottom:40px;">
          <h2 style="font-size:1.25rem;font-weight:600;color:var(--text);margin-bottom:16px;font-family:'Source Code Pro',monospace;">
            <span style="color:var(--red);">//</span> Install
          </h2>
          <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:var(--radius);padding:16px;font-family:'Source Code Pro',monospace;font-size:0.85rem;overflow-x:auto;">
            <p style="color:var(--red);white-space:pre-wrap;">$ {project.install}</p>
          </div>
        </section>
      )}

      {project.usage && (
        <section style="margin-bottom:40px;">
          <h2 style="font-size:1.25rem;font-weight:600;color:var(--text);margin-bottom:16px;font-family:'Source Code Pro',monospace;">
            <span style="color:var(--red);">//</span> Usage
          </h2>
          <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:var(--radius);padding:16px;font-family:'Source Code Pro',monospace;font-size:0.85rem;line-height:2;overflow-x:auto;white-space:pre-wrap;">
            {project.usage.split('\n').map((line) => (
              <p><span style="color:var(--red);">$</span> <span style="color:var(--cyan);">{line}</span></p>
            ))}
          </div>
        </section>
      )}

      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href={project.github} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:var(--red);color:#fff;font-family:'Source Code Pro',monospace;font-weight:600;border-radius:var(--radius);text-decoration:none;font-size:0.85rem;transition:all 0.2s ease-in-out;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
          View on GitHub
        </a>
        <a href="/projects" style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border:1px solid var(--border);color:var(--text-muted);font-family:'Source Code Pro',monospace;border-radius:var(--radius);text-decoration:none;font-size:0.85rem;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--border-hover)'" onmouseout="this.style.borderColor='var(--border)'">
          All Projects
        </a>
      </div>

      <a href="/projects" style="display:inline-flex;align-items:center;gap:8px;margin-top:40px;color:var(--red);font-family:'Source Code Pro',monospace;font-size:0.85rem;text-decoration:none;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
        &larr; Back to Projects
      </a>

      <!-- Related projects -->
      {related.length > 0 && (
        <div style="margin-top:64px;">
          <p style="font-family:'Source Code Pro',monospace;color:var(--red);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:16px;">// related projects</p>
          <div class="scroll-stagger" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;">
            {related.map((r) => {
              const rColor = categoryColor(r.category);
              return (
                <a href={`/projects/${r.slug}`} style="text-decoration:none;display:block;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--border)';this.style.transform='none'">
                  <div style={`display:inline-flex;padding:3px 8px;font-size:0.65rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:${rColor}15;color:${rColor};border:1px solid ${rColor}22;margin-bottom:12px;`}>{categoryLabel(r.category)}</div>
                  <h3 style="font-size:0.95rem;font-weight:600;color:var(--text);margin-bottom:8px;line-height:1.4;">{r.title}</h3>
                  <span style="color:var(--text-muted);font-size:0.72rem;font-family:'Source Code Pro',monospace;">{r.publishedAt}</span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>