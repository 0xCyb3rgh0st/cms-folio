---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const projects = [
  { title: "pwnlibc", desc: "Advanced libc identification toolkit for exploit development. Fast libc identification, automatic download, symbol lookup, Python API, and CLI.", cat: "binary-exploitation", tags: ["Python", "Exploit Dev", "CLI"], featured: true, slug: "pwnlibc", github: "https://github.com/0xCyb3rgh0st/pwnlibc.git", date: "2024-08-01" },
  { title: "HexSnare", desc: "Hexadecimal analysis and parsing toolkit for binary analysis, CTF challenges, and exploit development.", cat: "binary-exploitation", tags: ["Python", "Binary", "Hex"], featured: true, slug: "hexsnare", github: "https://github.com/0xCyb3rgh0st/HexSnare", date: "2024-07-15" },
  { title: "csrf-proc", desc: "CSRF vulnerability detection and exploitation framework for web application security testing.", cat: "web", tags: ["Python", "Web", "CSRF"], featured: true, slug: "csrf-proc", github: "https://github.com/0xCyb3rgh0st/csrf-proc.git", date: "2024-06-20" },
  { title: "ghidra-open", desc: "One-command launcher for Ghidra. Binary → Automatic Project → Headless Analysis → Launch GUI.", cat: "reverse-engineering", tags: ["Ghidra", "Automation", "Java"], featured: false, slug: "ghidra-open", github: "https://github.com/0xCyb3rgh0st/ghidra-open", date: "2024-05-10" },
  { title: "VulnOS", desc: "An open-source workspace for vulnerability research. In Development.", cat: "vulnerability-research", tags: ["Python", "AI", "Workspace"], featured: false, slug: "vulnos", github: "#", date: "2024-04-01" },
  { title: "CrackTheCode", desc: "Final year project - interactive cryptography and code-breaking challenge platform.", cat: "web", tags: ["Python", "Crypto", "Education"], featured: false, slug: "crackthecode", github: "https://github.com/0xCyb3rgh0st/crackthecode.git", date: "2024-03-01" },
];

const catColors: Record<string, string> = { "binary-exploitation": "var(--green)", "reverse-engineering": "var(--cyan)", "vulnerability-research": "var(--purple)", "web": "var(--yellow)" };
---
<BaseLayout title="Projects | Jatin Singh">
  <Navigation />
  <main style="padding-top:120px;padding-bottom:64px;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.875rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// projects</p>
      <h1 style="font-size:clamp(2rem,5vw,3rem);font-weight:800;margin-bottom:4px;">
        <span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">All</span>
        <span style="color:var(--text);"> Projects</span>
      </h1>
      <p style="color:var(--text-muted);margin-bottom:48px;max-width:600px;">
        Building world-class open-source tools that make vulnerability research easier.
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;">
        {projects.map((p) => (
          <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:24px;transition:all 0.3s;display:flex;flex-direction:column;" onmouseover="this.style.borderColor='var(--green)';this.style.transform='translateY(-4px)'" onmouseout="this.style.borderColor='var(--border)';this.style.transform='none'">
            {p.featured && (
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
                <div style="width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);"></div>
                <span style="color:var(--green);font-size:0.7rem;font-family:'JetBrains Mono',monospace;">FEATURED</span>
              </div>
            )}
            <span style={`display:inline-flex;padding:2px 8px;font-size:0.7rem;font-family:'JetBrains Mono',monospace;border-radius:4px;background:${catColors[p.cat]}15;color:${catColors[p.cat]};border:1px solid ${catColors[p.cat]}33;width:fit-content;margin-bottom:12px;text-transform:capitalize;`}>
              {p.cat.replace("-", " ")}
            </span>
            <h3 style="font-size:1.25rem;font-weight:700;color:var(--text);margin-bottom:8px;">{p.title}</h3>
            <p style="color:var(--text-muted);font-size:0.875rem;line-height:1.6;margin-bottom:16px;flex-grow:1;">{p.desc}</p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;">
              {p.tags.map((t) => (
                <span style="font-size:0.7rem;font-family:'JetBrains Mono',monospace;color:var(--text-muted);background:var(--bg-tertiary);padding:3px 8px;border-radius:4px;">{t}</span>
              ))}
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="color:var(--text-muted);font-size:0.75rem;font-family:'JetBrains Mono',monospace;">{p.date}</span>
              <a href={p.github} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;font-size:0.875rem;color:var(--green);font-family:'JetBrains Mono',monospace;text-decoration:none;">
                GitHub &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
