---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'nasa-vdp' }, props: { title: 'NASA VDP Recognition', issuer: 'National Aeronautics and Space Administration', color: 'var(--cyan)', icon: 'NASA', date: '2024', desc: 'Recognized by NASA for identifying and responsibly reporting security vulnerabilities under NASA\'s Vulnerability Disclosure Policy (VDP). This letter acknowledges contribution to protecting the integrity and availability of NASA information systems.', pdfUrl: '/nasa-vdp-letter.pdf' } },
  ];
}

const { title, issuer, color, icon, date, desc, pdfUrl } = Astro.props;
---
<BaseLayout title={`${title} | Achievement`}>
  <Navigation />
  <main style="padding-top:120px;padding-bottom:64px;min-height:100vh;">
    <div style="max-width:1000px;margin:0 auto;padding:0 24px;">
      <a href="/" style="display:inline-flex;align-items:center;gap:8px;color:var(--green);font-family:'JetBrains Mono',monospace;font-size:0.85rem;text-decoration:none;margin-bottom:32px;">
        &larr; Back to Portfolio
      </a>

      <div style="display:flex;align-items:center;gap:20px;margin-bottom:16px;">
        <div style={`width:80px;height:80px;border-radius:20px;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:1rem;background:${color}15;color:${color};border:2px solid ${color}33;flex-shrink:0;`}>
          {icon}
        </div>
        <div>
          <h1 style="font-size:2.5rem;font-weight:800;color:var(--text);margin-bottom:4px;">{title}</h1>
          <p style="color:var(--text-muted);font-size:1rem;">{issuer} &middot; {date}</p>
        </div>
      </div>

      <p style="color:var(--text-muted);font-size:1rem;line-height:1.7;margin-bottom:40px;max-width:700px;">{desc}</p>

      {pdfUrl && (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:32px;">
          <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
            <span style="font-family:'JetBrains Mono',monospace;font-size:0.8rem;color:var(--text-muted);">Official Letter</span>
            <a href={pdfUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:var(--green);color:#0a0a0f;border-radius:8px;font-family:'JetBrains Mono',monospace;font-size:0.8rem;font-weight:600;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download PDF
            </a>
          </div>
          <iframe src={pdfUrl} style="width:100%;height:700px;border:none;background:#f5f5f5;" title={`${title} PDF`}></iframe>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
