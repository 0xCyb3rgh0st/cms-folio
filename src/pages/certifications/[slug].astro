---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'crto' }, props: { title: 'CRTO', issuer: 'Zero-Point Security', color: 'var(--red)', icon: 'ZER', verifyUrl: 'https://certs.zeropointsecurity.co.uk/47b1d1bc-721c-4648-8674-78059cb6b67a#acc.ZC8uI47n', embedUrl: 'https://certs.zeropointsecurity.co.uk/47b1d1bc-721c-4648-8674-78059cb6b67a#acc.ZC8uI47n' } },
    { params: { slug: 'cpts' }, props: { title: 'CPTS', issuer: 'Hack The Box', color: 'var(--cyan)', icon: 'HTB', verifyUrl: 'https://www.hackthebox.com/certificates', embedUrl: null, validateHint: 'Go to hackthebox.com/certificates — Name: Jatin Singh Tomar — Code: HTBCERT-FB4BFC0460' } },
    { params: { slug: 'ewptxv3' }, props: { title: 'eWPTXv3', issuer: 'INE Security', color: 'var(--green)', icon: 'INE', verifyUrl: 'https://certs.ine.com/865223f9-11cc-433c-87f3-b62458b4fa65#acc.7bNOikDT', embedUrl: 'https://certs.ine.com/865223f9-11cc-433c-87f3-b62458b4fa65#acc.7bNOikDT' } },
    { params: { slug: 'crta' }, props: { title: 'CRTA', issuer: 'Zero-Point Security', color: 'var(--yellow)', icon: 'ZER', verifyUrl: 'http://credential.net/7e3ffd1f-07f5-411d-af1e-42ef68c5c3df#acc.3xWTP9nd', embedUrl: 'http://credential.net/7e3ffd1f-07f5-411d-af1e-42ef68c5c3df#acc.3xWTP9nd' } },
    { params: { slug: 'acp' }, props: { title: 'ACP', issuer: 'APIsec', color: 'var(--purple)', icon: 'API', verifyUrl: 'https://www.credly.com/badges/f34cf451-ab6d-40a7-bec6-bc17630d523d/', embedUrl: 'https://www.credly.com/badges/f34cf451-ab6d-40a7-bec6-bc17630d523d/embed' } },
  ];
}

const { title, issuer, color, icon, verifyUrl, embedUrl, validateHint } = Astro.props;
---
<BaseLayout title={`${title} | Certification`}>
  <Navigation />
  <main style="padding-top:120px;padding-bottom:64px;min-height:100vh;">
    <div style="max-width:1000px;margin:0 auto;padding:0 24px;">
      <a href="/" style="display:inline-flex;align-items:center;gap:8px;color:var(--green);font-family:'JetBrains Mono',monospace;font-size:0.85rem;text-decoration:none;margin-bottom:32px;">
        &larr; Back to Portfolio
      </a>

      <div style="display:flex;align-items:center;gap:20px;margin-bottom:40px;">
        <div style={`width:80px;height:80px;border-radius:20px;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:1.1rem;background:${color}15;color:${color};border:2px solid ${color}33;flex-shrink:0;`}>
          {icon}
        </div>
        <div>
          <h1 style="font-size:2.5rem;font-weight:800;color:var(--text);margin-bottom:4px;">{title}</h1>
          <p style="color:var(--text-muted);font-size:1rem;">{issuer}</p>
        </div>
      </div>

      {embedUrl ? (
        <div id="cert-embed" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;overflow:hidden;margin-bottom:32px;">
          <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
            <span style="font-family:'JetBrains Mono',monospace;font-size:0.8rem;color:var(--text-muted);">Certificate Preview</span>
            <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:var(--green);color:#0a0a0f;border-radius:8px;font-family:'JetBrains Mono',monospace;font-size:0.8rem;font-weight:600;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              Open Fullscreen
            </a>
          </div>
          <iframe src={embedUrl} id="cert-iframe" style="width:100%;height:600px;border:none;background:#fff;" title={`${title} Certificate`} onload="this.style.display='block'" onerror="document.getElementById('cert-fallback').style.display='block';this.style.display='none';document.querySelector('#cert-embed .cert-header').style.display='none'"></iframe>
          <div id="cert-fallback" style="display:none;padding:60px 20px;text-align:center;">
            <p style="color:var(--text-muted);margin-bottom:20px;">Certificate preview unavailable in iframe.</p>
            <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;background:var(--green);color:#0a0a0f;border-radius:10px;font-family:'JetBrains Mono',monospace;font-size:0.9rem;font-weight:700;text-decoration:none;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              View Certificate
            </a>
          </div>
        </div>
      ) : validateHint ? (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:40px;margin-bottom:32px;text-align:center;">
          <div style="width:80px;height:80px;border-radius:50%;background:var(--cyan)15;border:2px solid var(--cyan)33;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h2 style="font-size:1.5rem;font-weight:700;color:var(--text);margin-bottom:12px;">Manual Validation Required</h2>
          <p style="color:var(--text-muted);margin-bottom:32px;max-width:500px;margin-left:auto;margin-right:auto;">This certificate requires manual validation. Follow the steps below to verify.</p>
          
          <div style="background:var(--bg-tertiary);border:1px solid var(--border);border-radius:12px;padding:24px;max-width:500px;margin:0 auto 32px;text-align:left;">
            {validateHint.split(' — ').map((part, i) => (
              <div style="display:flex;gap:12px;margin-bottom:16px;align-items:flex-start;">
                <span style={`font-family:'JetBrains Mono',monospace;font-size:0.8rem;font-weight:700;color:${i === 0 ? 'var(--cyan)' : i === 1 ? 'var(--green)' : 'var(--yellow)'};min-width:60px;`}>
                  {i === 0 ? 'STEP' : i === 1 ? 'NAME' : 'CODE'}
                </span>
                <span style="font-family:'JetBrains Mono',monospace;font-size:0.85rem;color:var(--text);word-break:break-all;">{part}</span>
              </div>
            ))}
          </div>

          <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;background:var(--cyan);color:#0a0a0f;border-radius:10px;font-family:'JetBrains Mono',monospace;font-size:0.9rem;font-weight:700;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Open Validator
          </a>
        </div>
      ) : (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:40px;margin-bottom:32px;text-align:center;">
          <div style="width:80px;height:80px;border-radius:50%;background:${color}15;border:2px solid ${color}33;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h2 style="font-size:1.5rem;font-weight:700;color:var(--text);margin-bottom:12px;">Certificate Verified</h2>
          <p style="color:var(--text-muted);margin-bottom:32px;">Click below to view the official verification page.</p>
          <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:14px 28px;background:var(--green);color:#0a0a0f;border-radius:10px;font-family:'JetBrains Mono',monospace;font-size:0.9rem;font-weight:700;text-decoration:none;transition:all 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            View Certificate
          </a>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
