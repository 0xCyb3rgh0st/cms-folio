---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'crto' }, props: { title: 'CRTO', issuer: 'Zero-Point Security', color: 'var(--red)', icon: 'ZPS', verifyUrl: 'https://certs.zeropointsecurity.co.uk/47b1d1bc-721c-4648-8674-78059cb6b67a#acc.ZC8uI47n', embedUrl: 'https://certs.zeropointsecurity.co.uk/47b1d1bc-721c-4648-8674-78059cb6b67a#acc.ZC8uI47n' } },
    { params: { slug: 'cpts' }, props: { title: 'CPTS', issuer: 'Hack The Box', color: 'var(--cyan)', icon: 'HTB', verifyUrl: 'https://www.hackthebox.com/certificates', embedUrl: null, validateHint: 'Go to hackthebox.com/certificates — Name: Jatin Singh Tomar — Code: HTBCERT-FB4BFC0460' } },
    { params: { slug: 'ewptxv3' }, props: { title: 'eWPTXv3', issuer: 'INE Security', color: 'var(--red)', icon: 'INE', verifyUrl: 'https://certs.ine.com/865223f9-11cc-433c-87f3-b62458b4fa65#acc.7bNOikDT', embedUrl: 'https://certs.ine.com/865223f9-11cc-433c-87f3-b62458b4fa65#acc.7bNOikDT' } },
    { params: { slug: 'crta' }, props: { title: 'CRTA', issuer: 'Cyber Warfare Labs', color: 'var(--yellow)', icon: 'CWL', verifyUrl: 'http://credential.net/7e3ffd1f-07f5-411d-af1e-42ef68c5c3df#acc.3xWTP9nd', embedUrl: null } },
    { params: { slug: 'acp' }, props: { title: 'ACP', issuer: 'APIsec', color: 'var(--purple)', icon: 'API', verifyUrl: 'https://www.credly.com/badges/f34cf451-ab6d-40a7-bec6-bc17630d523d/', embedUrl: null } },
  ];
}

const { title, issuer, color, icon, verifyUrl, embedUrl, validateHint } = Astro.props;
---
<BaseLayout title={`${title} | Certification`}>
  <Navigation />
  <main id="main-content" style="padding-top:120px;padding-bottom:64px;min-height:100vh;">
    <div style="max-width:1000px;margin:0 auto;padding:0 24px;">
      <a href="/" style="display:inline-flex;align-items:center;gap:8px;color:var(--red);font-family:'Source Code Pro',monospace;font-size:0.85rem;text-decoration:none;margin-bottom:32px;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
        &larr; Back to Portfolio
      </a>

      <div style="display:flex;align-items:center;gap:16px;margin-bottom:40px;">
        <div style={`width:64px;height:64px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-family:'Source Code Pro',monospace;font-weight:700;font-size:0.9rem;background:${color}15;color:${color};border:1px solid ${color}22;flex-shrink:0;`}>
          {icon}
        </div>
        <div>
          <h1 style="font-size:2.25rem;font-weight:700;color:var(--text);margin-bottom:4px;">{title}</h1>
          <p style="color:var(--text-muted);font-size:0.95rem;">{issuer}</p>
        </div>
      </div>

      {embedUrl ? (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:32px;">
          <div id="cert-header" style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
            <span style="font-family:'Source Code Pro',monospace;font-size:0.75rem;color:var(--text-muted);">Certificate Preview</span>
            <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:var(--red);color:var(--bg-primary);border-radius:6px;font-family:'Source Code Pro',monospace;font-size:0.75rem;font-weight:600;text-decoration:none;transition:all 0.2s ease-in-out;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              Open Fullscreen
            </a>
          </div>
          <div id="cert-iframe-wrap" style="position:relative;display:none;">
            <iframe src={embedUrl} id="cert-iframe" style="width:100%;height:600px;border:none;background:#fff;" title={`${title} Certificate`}></iframe>
          </div>
          <div id="cert-fallback" style="padding:60px 20px;text-align:center;">
            <p style="color:var(--text-muted);margin-bottom:20px;font-size:0.9rem;">Certificate preview unavailable in iframe.</p>
            <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:12px 24px;background:var(--red);color:var(--bg-primary);border-radius:var(--radius);font-family:'Source Code Pro',monospace;font-size:0.85rem;font-weight:600;text-decoration:none;transition:all 0.2s ease-in-out;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              View Certificate
            </a>
          </div>
          <script>
            (function() {
              var iframe = document.getElementById('cert-iframe');
              var wrap = document.getElementById('cert-iframe-wrap');
              var fallback = document.getElementById('cert-fallback');
              var loaded = false;
              iframe.onload = function() {
                loaded = true;
                wrap.style.display = 'block';
                fallback.style.display = 'none';
              };
              setTimeout(function() {
                if (!loaded) {
                  wrap.style.display = 'none';
                  fallback.style.display = 'block';
                }
              }, 5000);
            })();
          </script>
        </div>
      ) : validateHint ? (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:40px;margin-bottom:32px;text-align:center;">
          <div style="width:64px;height:64px;border-radius:50%;background:var(--cyan)15;border:1px solid var(--cyan)22;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--cyan)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h2 style="font-size:1.25rem;font-weight:600;color:var(--text);margin-bottom:10px;">Manual Validation Required</h2>
          <p style="color:var(--text-muted);margin-bottom:28px;max-width:500px;margin-left:auto;margin-right:auto;font-size:0.9rem;">This certificate requires manual validation. Follow the steps below to verify.</p>
          
          <div style="background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--radius);padding:20px;max-width:500px;margin:0 auto 28px;text-align:left;">
            {validateHint.split(' — ').map((part, i) => (
              <div style="display:flex;gap:12px;margin-bottom:14px;align-items:flex-start;">
                <span style={`font-family:'Source Code Pro',monospace;font-size:0.75rem;font-weight:700;color:${i === 0 ? 'var(--cyan)' : i === 1 ? 'var(--red)' : 'var(--yellow)'};min-width:50px;`}>
                  {i === 0 ? 'STEP' : i === 1 ? 'NAME' : 'CODE'}
                </span>
                <span style="font-family:'Source Code Pro',monospace;font-size:0.8rem;color:var(--text);word-break:break-all;">{part}</span>
              </div>
            ))}
          </div>

          <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:12px 24px;background:var(--cyan);color:var(--bg-primary);border-radius:var(--radius);font-family:'Source Code Pro',monospace;font-size:0.85rem;font-weight:600;text-decoration:none;transition:all 0.2s ease-in-out;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Open Validator
          </a>
        </div>
      ) : (
        <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:40px;margin-bottom:32px;text-align:center;">
          <div style="width:64px;height:64px;border-radius:50%;background:${color}15;border:1px solid ${color}22;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h2 style="font-size:1.25rem;font-weight:600;color:var(--text);margin-bottom:10px;">Certificate Verified</h2>
          <p style="color:var(--text-muted);margin-bottom:28px;font-size:0.9rem;">Click below to view the official verification page.</p>
          <a href={verifyUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:8px;padding:12px 24px;background:var(--red);color:var(--bg-primary);border-radius:var(--radius);font-family:'Source Code Pro',monospace;font-size:0.85rem;font-weight:600;text-decoration:none;transition:all 0.2s ease-in-out;" onmouseover="this.style.opacity='0.85'" onmouseout="this.style.opacity='1'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            View Certificate
          </a>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
