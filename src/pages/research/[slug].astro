---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getBySlug, getRelated, categoryLabel, renderMarkdown, CATEGORY_COLORS, DIFFICULTY_COLORS } from '../../data/research';

export function getStaticPaths() {
  const slugs = ['owasp-2025-ai-vulnerabilities', 'pwnlibc-deep-dive', 'ghidra-open-automation', 'ad-attack-automation', 'heap-exploitation-guide'];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const researchEntry = getBySlug(slug!);
if (!researchEntry) {
  return Astro.redirect('/research');
}
const related = getRelated(researchEntry, 3);
const catColor = CATEGORY_COLORS[researchEntry.category] || 'var(--red)';
const diffColor = DIFFICULTY_COLORS[researchEntry.difficulty] || 'var(--red)';
const rendered = renderMarkdown(researchEntry.content);
---
<BaseLayout title={`${researchEntry.title} | Jatin Singh`} description={researchEntry.description}>
  <Navigation />
  <main id="main-content" style="padding-top:120px;padding-bottom:64px;">
    <div style="max-width:800px;margin:0 auto;padding:0 24px;">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" style="font-family:'Source Code Pro',monospace;font-size:0.8rem;color:var(--text-muted);margin-bottom:24px;">
        <a href="/" style="color:var(--text-muted);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text-muted)'">Home</a>
        <span style="margin:0 8px;opacity:0.5;">/</span>
        <a href="/research" style="color:var(--text-muted);text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='var(--red)'" onmouseout="this.style.color='var(--text-muted)'">Research</a>
        <span style="margin:0 8px;opacity:0.5;">/</span>
        <span style="color:var(--red);">{categoryLabel(researchEntry.category)}</span>
      </nav>

      <div style="margin-bottom:32px;">
        <div style="display:flex;gap:6px;margin-bottom:14px;">
          <span style={`display:inline-flex;padding:4px 12px;font-size:0.7rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:${catColor}15;color:${catColor};border:1px solid ${catColor}22;text-transform:uppercase;letter-spacing:0.1em;`}>{categoryLabel(researchEntry.category)}</span>
          <span style={`display:inline-flex;padding:4px 12px;font-size:0.7rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:${diffColor}15;color:${diffColor};border:1px solid ${diffColor}22;text-transform:capitalize;`}>{researchEntry.difficulty}</span>
        </div>
        <h1 style="font-size:clamp(1.6rem,4vw,2.25rem);font-weight:700;color:var(--text);margin-bottom:12px;line-height:1.3;">{researchEntry.title}</h1>
        <p style="color:var(--text-muted);font-size:0.85rem;font-family:'Source Code Pro',monospace;">{researchEntry.publishedAt}</p>
      </div>

      <!-- Tags + technologies -->
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;">
        {researchEntry.tags.map((t) => (
          <span style="display:inline-flex;padding:3px 10px;font-size:0.7rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:var(--bg-tertiary);color:var(--text-muted);">#{t}</span>
        ))}
      </div>

      <!-- Short introduction -->
      <div style="border-left:3px solid var(--red);padding:4px 0 4px 20px;margin-bottom:40px;">
        <p style="color:var(--text);font-size:1.05rem;line-height:1.7;">{researchEntry.description}</p>
      </div>

      <!-- Full content -->
      <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:40px 32px;line-height:1.8;color:var(--text-muted);" class="research-content">
        <div set:html={rendered} />
      </div>

      <!-- References / stack -->
      {researchEntry.technologies.length > 0 && (
        <div style="margin-top:32px;">
          <p style="font-family:'Source Code Pro',monospace;font-size:0.7rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.15em;margin-bottom:12px;">// stack &amp; references</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            {researchEntry.technologies.map((t) => (
              <span style="display:inline-flex;padding:5px 12px;font-size:0.72rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:var(--bg-card);border:1px solid var(--border);color:var(--text-muted);">{t}</span>
            ))}
          </div>
        </div>
      )}

      <a href="/research" style="display:inline-flex;align-items:center;gap:8px;margin-top:40px;color:var(--red);font-family:'Source Code Pro',monospace;font-size:0.85rem;text-decoration:none;transition:opacity 0.2s;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
        &larr; Back to Research
      </a>

      <!-- Related research -->
      {related.length > 0 && (
        <div style="margin-top:64px;">
          <p style="font-family:'Source Code Pro',monospace;color:var(--red);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:16px;">// related research</p>
          <div class="scroll-stagger" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;">
            {related.map((r) => {
              const cColor = CATEGORY_COLORS[r.category] || 'var(--red)';
              return (
                <a href={`/research/${r.slug}`} style="text-decoration:none;display:block;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='var(--border)';this.style.transform='none'">
                  <div style={`display:inline-flex;padding:3px 8px;font-size:0.65rem;font-family:'Source Code Pro',monospace;border-radius:6px;background:${cColor}15;color:${cColor};border:1px solid ${cColor}22;margin-bottom:12px;`}>{categoryLabel(r.category)}</div>
                  <h3 style="font-size:0.95rem;font-weight:600;color:var(--text);margin-bottom:8px;line-height:1.4;">{r.title}</h3>
                  <span style="color:var(--text-muted);font-size:0.72rem;font-family:'Source Code Pro',monospace;">{r.publishedAt}</span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>