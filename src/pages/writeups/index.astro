---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const writeups = [
  { title: "OWASP Top 10:2025 AI-Generated Code Vulnerabilities", desc: "Gap analysis of OWASP's 2025 AI security risks against real-world LLM outputs. Testing local models for prompt injection, insecure code generation, and supply chain risks.", cat: "vulnerability", diff: "hard", date: "2025-08-15", tags: ["AI Security", "OWASP", "LLM", "Prompt Injection"], slug: "owasp-2025-ai-vulnerabilities" },
  { title: "pwnlibc: Building a libc identification tool", desc: "Deep dive into how pwnlibc identifies libc versions from leaked addresses and automates exploit development workflow.", cat: "technique", diff: "hard", date: "2024-08-01", tags: ["Python", "Exploit Dev", "libc"], slug: "pwnlibc-deep-dive" },
  { title: "Ghidra Automation with ghidra-open", desc: "How ghidra-open eliminates repetitive Ghidra setup with one-command project creation and headless analysis.", cat: "tool", diff: "medium", date: "2024-07-15", tags: ["Ghidra", "Automation", "Java"], slug: "ghidra-open-automation" },
  { title: "AD Attack Path Automation", desc: "Automating Active Directory attack paths from enumeration to domain compromise using BloodHound and Impacket.", cat: "technique", diff: "hard", date: "2024-06-20", tags: ["AD", "BloodHound", "Impacket"], slug: "ad-attack-automation" },
  { title: "Heap Exploitation Techniques", desc: "Comprehensive guide to modern heap exploitation including tcache poisoning, house of techniques.", cat: "technique", diff: "insane", date: "2024-05-10", tags: ["Pwn", "Heap", "Linux"], slug: "heap-exploitation-guide" },
];

const diffColors: Record<string, string> = { easy: "var(--green)", medium: "var(--yellow)", hard: "var(--red)", insane: "var(--purple)" };
const catColors: Record<string, string> = { ctf: "var(--cyan)", vulnerability: "var(--red)", technique: "var(--green)", tool: "var(--purple)", lab: "var(--yellow)" };
---
<BaseLayout title="Writeups | Jatin Singh">
  <Navigation />
  <main id="main-content" style="padding-top:120px;padding-bottom:64px;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'JetBrains Mono',monospace;color:var(--green);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px;">// writeups</p>
      <h1 style="font-size:clamp(2rem,5vw,3rem);font-weight:700;margin-bottom:4px;">
        <span style="background:linear-gradient(135deg,var(--green),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Security</span>
        <span style="color:var(--text);"> Writeups</span>
      </h1>
      <p style="color:var(--text-muted);margin-bottom:48px;max-width:600px;">
        Technical research, tooling deep-dives, and exploitation techniques.
      </p>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:20px;">
        {writeups.map((w) => (
          <a href={`/writeups/${w.slug}`} style="text-decoration:none;display:block;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;transition:all 0.2s ease-in-out;" onmouseover="this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.2)'" onmouseout="this.style.borderColor='var(--border)';this.style.transform='none';this.style.boxShadow='none'">
            <div style="display:flex;gap:6px;margin-bottom:12px;">
              <span style={`display:inline-flex;padding:3px 10px;font-size:0.7rem;font-family:'JetBrains Mono',monospace;border-radius:6px;background:${catColors[w.cat]}15;color:${catColors[w.cat]};border:1px solid ${catColors[w.cat]}22;text-transform:capitalize;`}>{w.cat}</span>
              <span style={`display:inline-flex;padding:3px 10px;font-size:0.7rem;font-family:'JetBrains Mono',monospace;border-radius:6px;background:${diffColors[w.diff]}15;color:${diffColors[w.diff]};border:1px solid ${diffColors[w.diff]}22;text-transform:capitalize;`}>{w.diff}</span>
            </div>
            <h3 style="font-size:1.05rem;font-weight:600;color:var(--text);margin-bottom:8px;">{w.title}</h3>
            <p style="color:var(--text-muted);font-size:0.875rem;line-height:1.6;margin-bottom:16px;">{w.desc}</p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;">
              {w.tags.map((t) => (
                <span style="font-size:0.7rem;font-family:'JetBrains Mono',monospace;color:var(--text-muted);background:var(--bg-tertiary);padding:3px 8px;border-radius:6px;">{t}</span>
              ))}
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="color:var(--text-muted);font-size:0.75rem;font-family:'JetBrains Mono',monospace;">{w.date}</span>
              <span style="color:var(--green);font-size:0.85rem;font-family:'JetBrains Mono',monospace;" class="arrow-hover">Read more &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
