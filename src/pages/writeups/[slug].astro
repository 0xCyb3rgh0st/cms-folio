---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { research } from '../../data/research';

export function getStaticPaths() {
  return research.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
---
<BaseLayout title="Redirecting | Jatin Singh">
  <Navigation />
  <main id="main-content" style="padding-top:120px;padding-bottom:64px;">
    <div style="max-width:800px;margin:0 auto;padding:0 24px;text-align:center;">
      <p style="color:var(--text-muted);margin-bottom:16px;font-family:'Source Code Pro',monospace;">Redirecting to the research journal...</p>
      <a href={`/research/${slug}`} style="color:var(--red);font-family:'Source Code Pro',monospace;font-size:0.85rem;text-decoration:none;border-bottom:1px solid var(--text-muted);">Go to /research/{slug} &rarr;</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  window.location.replace('/research/' + window.location.pathname.split('/').filter(Boolean).pop());
</script>